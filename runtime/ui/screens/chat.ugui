// Multiplayer chat, bottom-left. Fed from SetChatLines; collapses when empty,
// newest line at the bottom. The newest row is full white and the history
// secondary grey. A plate rather than shadows: this is a persistent block of
// small text over arbitrary scenes.

  panel chat_box {
    position: absolute; left: 52; bottom: 300; width: 460; class: plate_w;
    layout: column; align: start; gap: 4; visibility: collapsed; padding: 14 18 14 18;
    text chat_line0 { class: t_dim; text: ""; font-size: 13; }
    text chat_line1 { class: t_dim; text: ""; font-size: 13; }
    text chat_line2 { class: t_dim; text: ""; font-size: 13; }
    text chat_line3 { class: t_dim; text: ""; font-size: 13; }
    text chat_line4 { class: t_dim; text: ""; font-size: 13; }
    text chat_line5 { class: t_dim; text: ""; font-size: 13; }
    text chat_line6 { class: t_dim; text: ""; font-size: 13; }
    text chat_line7 { class: t_body; text: ""; font-size: 13; }
  }
