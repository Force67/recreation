// Container loot, on the menu chassis. container_item* (kContainerRows) is a
// fixed pool; container_head takes the container's own name.

  panel container_box {
    position: absolute; left: 0; top: 0; width: 100vw; height: 100vh;
    background: #000000e0; backdrop-blur: 26;
    panel container_card { position: absolute; left: 130; right: 130; top: 76; bottom: 0;
      layout: column;
      panel { layout: row; align: end; justify: space-between; width: 100%;
        text container_head { class: t_mast; text: ""; }
        text container_hint { class: t_micro2; text: "Esc to close"; }
      }
      panel { width: 100%; height: 1; margin: 26 0 0 0;
        background: #ffffff66; background-end: #ffffff00; gradient-angle: 90; }

      panel { flex-grow: 1; layout: column; width: 100%; max-width: 720; padding: 44 0 0 0;
        text { class: t_micro; text: "Contents"; margin: 0 0 18 0; }
        text container_item0  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item1  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item2  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item3  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item4  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item5  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item6  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item7  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item8  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item9  { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item10 { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item11 { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item12 { class: t_body; text: ""; margin: 0 0 9 0; }
        text container_item13 { class: t_body; text: ""; margin: 0 0 9 0; }
      }
      panel { height: 96; layout: row; align: center; gap: 44; width: 100%;
        panel { position: absolute; left: 0; right: 0; top: 0; height: 1; background: #ffffff1c; }
        ui_hint { k: "E"; a: "Take"; }
        ui_hint { k: "Esc"; a: "Close"; }
      }
    }
  }
