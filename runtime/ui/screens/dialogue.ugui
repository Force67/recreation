// Dialogue, bottom-centre. The topic list is static rather than a centred
// scroll. GameUi toggles dialogue_box as a unit and each row inside it, so one
// plate holds the lot and collapsed topics shrink it.

  panel dialogue_box {
    position: absolute; left: 0; bottom: 90; width: 100vw; layout: column; align: center;
    panel { class: plate_w; layout: column; align: start; width: 900; padding: 26 34 28 34;
      text dialogue_speaker { class: t_micro; text: ""; color: #ffffff; }
      text dialogue_npc { class: t_body; text: ""; font-size: 19; margin: 12 0 0 0; }
      panel { class: rule_dim; width: 100%; margin: 20 0 18 0; }
      text dialogue_opt0 { class: t_body; text: ""; margin: 0 0 10 0; }
      text dialogue_opt1 { class: t_body; text: ""; margin: 0 0 10 0; }
      text dialogue_opt2 { class: t_body; text: ""; margin: 0 0 10 0; }
      text dialogue_opt3 { class: t_body; text: ""; margin: 0 0 10 0; }
    }
  }
