// RECREATION first-run setup: the five pages a fresh install walks before the
// NEXUS front screen. Same chassis as main_menu.ugui and pause_menu.ugui -
// masthead, entry list left, detail pane right, key-hint footer - so the first
// thing a new player sees is already the interface they will live in. The list
// is the progress: the current step carries the 2px marker and the plate wash,
// done steps sit at 60% white, pending at 37%. See docs/ui-mock/.
//
// Monochrome by the same rule as the rest of the front-end: state is value, not
// hue, so "located" is a filled pip and full-white text rather than a green
// label. Nothing is rounded and nothing glows.
//
// Engine constraints this is written around (see theme.ugui):
//   - a bordered panel needs an OPAQUE background or ugui floods the rect with
//     the border colour, which is why every outlined control carries #0a0a0a.
//   - text never wraps: one text widget per line.
//   - `visibility:` in markup is ignored; GameUi::ApplyFirstRun collapses the
//     four inactive pages every frame.
//   - NO POPOVERS. ugui's HitTest returns kNullWidget the moment a point falls
//     outside a widget's own rect, so a menu hanging below its trigger can be
//     drawn but never clicked: the press falls through to whatever sits under
//     it. Mode and difficulty are segmented rows for that reason, which is also
//     the system's own "the active member of a set gets a 2px rule" shape.
//
// Drives the widgets GameUi expects:
//   fr_step0..4, fr_meta, fr_bignum, fr_prog (+fr_prog_t), fr_build,
//   fr_nav0..4 (fr_navsel/fr_navplate/fr_navnum/fr_navlbl),
//   fr_w_games, fr_row0..2 (fr_pip/fr_name/fr_path/fr_stat/fr_browse),
//   fr_loccount, fr_lochint, fr_next1 (+fr_next1_t),
//   fr_modeopt0..3 (fr_modebar/fr_modelbl) and the same for fr_diff*,
//   fr_chk0..2 (fr_chkbox/fr_chkmk), fr_modspath_t, fr_browse_mods, fr_space,
//   fr_sum_games/fr_sum_mode/fr_sum_mods/fr_sum_diag/fr_sum_upd,
//   fr_begin/fr_skip/fr_back1..4/fr_next1..3/fr_launch.

  panel firstrun {
    position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; background: #000000;
    panel { position: absolute; left: 0; top: 0; right: 0; bottom: 0;
      background: #0e1013; background-end: #000000; gradient-angle: 180; }

    panel { position: absolute; left: 130; right: 130; top: 64; bottom: 0; layout: column;

      // ===================== masthead =====================
      panel { layout: row; align: end; justify: space-between; width: 100%;
        text { class: t_mast; font-size: 32; letter-spacing: 13; text: "Recreation"; }
        panel { layout: column; align: end; gap: 7;
          text { class: t_micro; text: "First-time setup"; }
          text fr_meta { class: t_micro2; text: "Step 01 of 05"; } }
      }
      panel { width: 100%; height: 1; margin: 22 0 0 0;
        background: #ffffff66; background-end: #ffffff00; gradient-angle: 90; }

      // ===================== body =====================
      panel { layout: row; width: 100%; flex-grow: 1; margin: 30 0 0 0;

        // ---- step list (the progress rail) ----
        panel { width: 396; layout: column;
          panel fr_nav0 { height: 82; position: relative; layout: row; align: center;
            cursor: pointer;
            panel fr_navplate0 { position: absolute; left: 0; top: 0; bottom: 0; right: 0;
              background: #17191c; background-end: #17191c00; gradient-angle: 90; }
            panel fr_navsel0 { position: absolute; left: 0; top: 0; bottom: 0; width: 2;
              background: #ffffff; }
            panel { layout: row; align: center; gap: 22; padding: 0 0 0 26;
              text fr_navnum0 { font-size: 11; letter-spacing: 3; color: #ffffff; text: "01"; }
              panel { layout: column; gap: 6;
                text fr_navlbl0 { font-size: 21; letter-spacing: 2; color: #ffffff; text: "Welcome"; }
                text { class: t_micro2; text: "What this is"; } } } }
          panel fr_nav1 { height: 82; position: relative; layout: row; align: center;
            cursor: pointer;
            panel fr_navplate1 { position: absolute; left: 0; top: 0; bottom: 0; right: 0;
              background: #17191c; background-end: #17191c00; gradient-angle: 90; }
            panel fr_navsel1 { position: absolute; left: 0; top: 0; bottom: 0; width: 2;
              background: #ffffff; }
            panel { layout: row; align: center; gap: 22; padding: 0 0 0 26;
              text fr_navnum1 { font-size: 11; letter-spacing: 3; color: #5e5e5e; text: "02"; }
              panel { layout: column; gap: 6;
                text fr_navlbl1 { font-size: 21; letter-spacing: 2; color: #5e5e5e; text: "Games"; }
                text { class: t_micro2; text: "Where your data lives"; } } } }
          panel fr_nav2 { height: 82; position: relative; layout: row; align: center;
            cursor: pointer;
            panel fr_navplate2 { position: absolute; left: 0; top: 0; bottom: 0; right: 0;
              background: #17191c; background-end: #17191c00; gradient-angle: 90; }
            panel fr_navsel2 { position: absolute; left: 0; top: 0; bottom: 0; width: 2;
              background: #ffffff; }
            panel { layout: row; align: center; gap: 22; padding: 0 0 0 26;
              text fr_navnum2 { font-size: 11; letter-spacing: 3; color: #5e5e5e; text: "03"; }
              panel { layout: column; gap: 6;
                text fr_navlbl2 { font-size: 21; letter-spacing: 2; color: #5e5e5e; text: "Play"; }
                text { class: t_micro2; text: "Mode and difficulty"; } } } }
          panel fr_nav3 { height: 82; position: relative; layout: row; align: center;
            cursor: pointer;
            panel fr_navplate3 { position: absolute; left: 0; top: 0; bottom: 0; right: 0;
              background: #17191c; background-end: #17191c00; gradient-angle: 90; }
            panel fr_navsel3 { position: absolute; left: 0; top: 0; bottom: 0; width: 2;
              background: #ffffff; }
            panel { layout: row; align: center; gap: 22; padding: 0 0 0 26;
              text fr_navnum3 { font-size: 11; letter-spacing: 3; color: #5e5e5e; text: "04"; }
              panel { layout: column; gap: 6;
                text fr_navlbl3 { font-size: 21; letter-spacing: 2; color: #5e5e5e; text: "Storage"; }
                text { class: t_micro2; text: "Mods and downloads"; } } } }
          panel fr_nav4 { height: 82; position: relative; layout: row; align: center;
            cursor: pointer;
            panel fr_navplate4 { position: absolute; left: 0; top: 0; bottom: 0; right: 0;
              background: #17191c; background-end: #17191c00; gradient-angle: 90; }
            panel fr_navsel4 { position: absolute; left: 0; top: 0; bottom: 0; width: 2;
              background: #ffffff; }
            panel { layout: row; align: center; gap: 22; padding: 0 0 0 26;
              text fr_navnum4 { font-size: 11; letter-spacing: 3; color: #5e5e5e; text: "05"; }
              panel { layout: column; gap: 6;
                text fr_navlbl4 { font-size: 21; letter-spacing: 2; color: #5e5e5e; text: "Ready"; }
                text { class: t_micro2; text: "Confirm and launch"; } } } }

          // the rail's own readout, pinned to the foot of the list
          panel { flex-grow: 1; }
          panel { layout: column; gap: 13; width: 320; margin: 0 0 52 0;
            panel { layout: row; align: center; justify: space-between; width: 100%;
              text { class: t_micro2; text: "Progress"; }
              text fr_prog_t { class: t_micro2; color: #9a9a9a; text: "20%"; } }
            panel { width: 100%; height: 2; background: #ffffff1c;
              panel fr_prog { width: 20%; height: 2; background: #ffffff; } } }
        }

        panel { width: 1; background: #ffffff1c; margin: 0 56 0 56; }

        // ---- detail pane ----
        panel { flex-grow: 1; position: relative; layout: column;
          // the page number as a watermark, anchoring the foot of the pane
          text fr_bignum { position: absolute; right: 8; bottom: 26; font-size: 210;
            letter-spacing: 4; color: #ffffff0a; text: "01"; }

          // ===================== 01 welcome =====================
          panel fr_step0 { layout: column; width: 100%;
            text { class: t_micro; text: "Welcome"; }
            text { class: t_h1; text: "One engine, many worlds"; margin: 14 0 0 0; }
            text { class: t_body; color: #9a9a9a; margin: 26 0 0 0;
              text: "Recreation plays the games you already own inside a single"; }
            text { class: t_body; color: #9a9a9a; margin: 8 0 0 0;
              text: "engine: Skyrim, Fallout, Starfield and their worlds side by"; }
            text { class: t_body; color: #9a9a9a; margin: 8 0 0 0;
              text: "side, with modding and multiplayer built in."; }

            panel { class: rule; width: 100%; max-width: 860; margin: 34 0 0 0; }
            panel { layout: row; width: 100%; max-width: 860; margin: 26 0 0 0;
              panel { width: 300; layout: column; gap: 12;
                text { class: t_micro2; text: "Detected"; }
                text fr_w_games { class: t_body; text: "-"; } }
              panel { width: 300; layout: column; gap: 12;
                text { class: t_micro2; text: "Takes"; }
                text { class: t_body; text: "About a minute"; } }
              panel { layout: column; gap: 12;
                text { class: t_micro2; text: "Reversible"; }
                text { class: t_body; text: "All of it, in Settings"; } } }
            panel { class: rule_dim; width: 100%; max-width: 860; margin: 26 0 0 0; }

            panel { layout: row; align: center; gap: 16; margin: 38 0 0 0;
              panel fr_begin { height: 46; padding: 0 40 0 40; cursor: pointer;
                layout: row; align: center; justify: center; background: #e8e8e8;
                :hover { background: #ffffff; }
                text { font-size: 12; letter-spacing: 5; text-transform: uppercase;
                  color: #000000; text: "Begin setup"; } }
              panel fr_skip { height: 46; padding: 0 24 0 24; cursor: pointer;
                layout: row; align: center; justify: center;
                background: #0a0a0a; border-color: #ffffff1c; border-width: 1;
                :hover { border-color: #ffffff8c; }
                text { font-size: 12; letter-spacing: 5; text-transform: uppercase;
                  color: #9a9a9a; text: "Skip for now"; } } }
          }

          // ===================== 02 locate =====================
          panel fr_step1 { layout: column; width: 100%;
            text { class: t_micro; text: "Game data"; }
            text { class: t_h1; text: "Point us at your games"; margin: 14 0 0 0; }
            text { class: t_body; color: #9a9a9a; margin: 26 0 0 0;
              text: "Recreation reads the original data files and ships none of its"; }
            text { class: t_body; color: #9a9a9a; margin: 8 0 0 0;
              text: "own. Installed copies are found for you; the rest you can point"; }
            text { class: t_body; color: #9a9a9a; margin: 8 0 0 0;
              text: "at by hand."; }

            panel { layout: row; align: center; justify: space-between; width: 100%;
              max-width: 1000; margin: 36 0 14 0;
              text { class: t_micro; text: "Installations"; }
              text fr_loccount { class: t_micro2; text: ""; } }
            panel { class: rule; width: 100%; max-width: 1000; }

            panel fr_row0 { layout: row; align: center; gap: 22; width: 100%; max-width: 1000;
              height: 62;
              panel fr_pip0 { width: 5; height: 5; background: #ffffff;
                border-color: #ffffff5e; border-width: 1; }
              text fr_name0 { class: t_body; width: 250; text: "Skyrim Special Edition"; }
              text fr_path0 { font: mono; font-size: 11; color: #5e5e5e; flex-grow: 1;
                text: "Not located"; }
              text fr_stat0 { class: t_micro2; width: 118; text: "Not found"; }
              panel fr_browse0 { height: 32; padding: 0 16 0 16; cursor: pointer;
                layout: row; align: center; justify: center;
                background: #0a0a0a; border-color: #ffffff33; border-width: 1;
                :hover { border-color: #ffffff; }
                text { class: t_micro2; color: #9a9a9a; text: "Browse"; } } }
            panel { class: rule_dim; width: 100%; max-width: 1000; }
            panel fr_row1 { layout: row; align: center; gap: 22; width: 100%; max-width: 1000;
              height: 62;
              panel fr_pip1 { width: 5; height: 5; background: #ffffff;
                border-color: #ffffff5e; border-width: 1; }
              text fr_name1 { class: t_body; width: 250; text: "Fallout 4"; }
              text fr_path1 { font: mono; font-size: 11; color: #5e5e5e; flex-grow: 1;
                text: "Not located"; }
              text fr_stat1 { class: t_micro2; width: 118; text: "Not found"; }
              panel fr_browse1 { height: 32; padding: 0 16 0 16; cursor: pointer;
                layout: row; align: center; justify: center;
                background: #0a0a0a; border-color: #ffffff33; border-width: 1;
                :hover { border-color: #ffffff; }
                text { class: t_micro2; color: #9a9a9a; text: "Browse"; } } }
            panel { class: rule_dim; width: 100%; max-width: 1000; }
            panel fr_row2 { layout: row; align: center; gap: 22; width: 100%; max-width: 1000;
              height: 62;
              panel fr_pip2 { width: 5; height: 5; background: #ffffff;
                border-color: #ffffff5e; border-width: 1; }
              text fr_name2 { class: t_body; width: 250; text: "Starfield"; }
              text fr_path2 { font: mono; font-size: 11; color: #5e5e5e; flex-grow: 1;
                text: "Not located"; }
              text fr_stat2 { class: t_micro2; width: 118; text: "Not found"; }
              panel fr_browse2 { height: 32; padding: 0 16 0 16; cursor: pointer;
                layout: row; align: center; justify: center;
                background: #0a0a0a; border-color: #ffffff33; border-width: 1;
                :hover { border-color: #ffffff; }
                text { class: t_micro2; color: #9a9a9a; text: "Browse"; } } }
            panel { class: rule; width: 100%; max-width: 1000; }

            text fr_lochint { class: t_faint; margin: 18 0 0 0;
              text: "One located game is enough to continue. The others can be added later."; }

            panel { layout: row; align: center; gap: 16; margin: 34 0 0 0;
              panel fr_next1 { height: 46; padding: 0 40 0 40; cursor: pointer;
                layout: row; align: center; justify: center; background: #e8e8e8;
                :hover { background: #ffffff; }
                text fr_next1_t { font-size: 12; letter-spacing: 5; text-transform: uppercase;
                  color: #000000; text: "Continue"; } }
              panel fr_back1 { height: 46; padding: 0 24 0 24; cursor: pointer;
                layout: row; align: center; justify: center;
                background: #0a0a0a; border-color: #ffffff1c; border-width: 1;
                :hover { border-color: #ffffff8c; }
                text { font-size: 12; letter-spacing: 5; text-transform: uppercase;
                  color: #9a9a9a; text: "Back"; } } }
          }

          // ===================== 03 preferences =====================
          panel fr_step2 { layout: column; width: 100%;
            text { class: t_micro; text: "Defaults"; }
            text { class: t_h1; text: "How you like to play"; margin: 14 0 0 0; }
            text { class: t_body; color: #9a9a9a; margin: 26 0 0 0;
              text: "Starting points for a new world. Every one of them can be"; }
            text { class: t_body; color: #9a9a9a; margin: 8 0 0 0;
              text: "changed per save, at any time."; }

            panel { layout: column; width: 100%; max-width: 860; margin: 34 0 0 0;
              panel { class: rule; width: 100%; }
              panel { layout: row; align: center; justify: space-between; width: 100%;
                height: 74;
                panel { layout: column; gap: 6;
                  text { class: t_body; text: "Default mode"; }
                  text { class: t_faint; text: "What a fresh world starts as"; } }
                panel { width: 470; layout: row; gap: 2;
                  panel fr_modeopt0 { flex-grow: 1; height: 46; position: relative;
                    cursor: pointer; layout: row; align: center; justify: center;
                    background: #0d0d0d;
                    :hover { background: #17191c; }
                    panel fr_modebar0 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                      background: #ffffff; }
                    text fr_modelbl0 { font-size: 11; letter-spacing: 3; text-transform: uppercase;
                      color: #9a9a9a; text: "Exploration"; } }
                  panel fr_modeopt1 { flex-grow: 1; height: 46; position: relative;
                    cursor: pointer; layout: row; align: center; justify: center;
                    background: #0d0d0d;
                    :hover { background: #17191c; }
                    panel fr_modebar1 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                      background: #ffffff; }
                    text fr_modelbl1 { font-size: 11; letter-spacing: 3; text-transform: uppercase;
                      color: #9a9a9a; text: "Story"; } }
                  panel fr_modeopt2 { flex-grow: 1; height: 46; position: relative;
                    cursor: pointer; layout: row; align: center; justify: center;
                    background: #0d0d0d;
                    :hover { background: #17191c; }
                    panel fr_modebar2 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                      background: #ffffff; }
                    text fr_modelbl2 { font-size: 11; letter-spacing: 3; text-transform: uppercase;
                      color: #9a9a9a; text: "Survival"; } }
                  panel fr_modeopt3 { flex-grow: 1; height: 46; position: relative;
                    cursor: pointer; layout: row; align: center; justify: center;
                    background: #0d0d0d;
                    :hover { background: #17191c; }
                    panel fr_modebar3 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                      background: #ffffff; }
                    text fr_modelbl3 { font-size: 11; letter-spacing: 3; text-transform: uppercase;
                      color: #9a9a9a; text: "Sandbox"; } } } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; align: center; justify: space-between; width: 100%;
                height: 74;
                panel { layout: column; gap: 6;
                  text { class: t_body; text: "Difficulty"; }
                  text { class: t_faint; text: "How hard the world pushes back"; } }
                panel { width: 470; layout: row; gap: 2;
                  panel fr_diffopt0 { flex-grow: 1; height: 46; position: relative;
                    cursor: pointer; layout: row; align: center; justify: center;
                    background: #0d0d0d;
                    :hover { background: #17191c; }
                    panel fr_diffbar0 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                      background: #ffffff; }
                    text fr_difflbl0 { font-size: 11; letter-spacing: 3; text-transform: uppercase;
                      color: #9a9a9a; text: "Novice"; } }
                  panel fr_diffopt1 { flex-grow: 1; height: 46; position: relative;
                    cursor: pointer; layout: row; align: center; justify: center;
                    background: #0d0d0d;
                    :hover { background: #17191c; }
                    panel fr_diffbar1 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                      background: #ffffff; }
                    text fr_difflbl1 { font-size: 11; letter-spacing: 3; text-transform: uppercase;
                      color: #9a9a9a; text: "Normal"; } }
                  panel fr_diffopt2 { flex-grow: 1; height: 46; position: relative;
                    cursor: pointer; layout: row; align: center; justify: center;
                    background: #0d0d0d;
                    :hover { background: #17191c; }
                    panel fr_diffbar2 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                      background: #ffffff; }
                    text fr_difflbl2 { font-size: 11; letter-spacing: 3; text-transform: uppercase;
                      color: #9a9a9a; text: "Hard"; } }
                  panel fr_diffopt3 { flex-grow: 1; height: 46; position: relative;
                    cursor: pointer; layout: row; align: center; justify: center;
                    background: #0d0d0d;
                    :hover { background: #17191c; }
                    panel fr_diffbar3 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                      background: #ffffff; }
                    text fr_difflbl3 { font-size: 11; letter-spacing: 3; text-transform: uppercase;
                      color: #9a9a9a; text: "Legendary"; } } } }
              panel { class: rule_dim; width: 100%; }

              panel fr_chk0 { layout: row; align: center; justify: space-between; width: 100%;
                height: 74; cursor: pointer;
                panel { layout: column; gap: 6;
                  text { class: t_body; text: "Enable mods by default"; }
                  text { class: t_faint; text: "Load installed modules when a world starts"; } }
                panel fr_chkbox0 { width: 22; height: 22; layout: column; justify: center;
                  align: center; background: #0a0a0a; border-color: #ffffff33; border-width: 1;
                  panel fr_chkmk0 { width: 10; height: 10; background: #ffffff; } } }
              panel { class: rule_dim; width: 100%; }
              panel fr_chk1 { layout: row; align: center; justify: space-between; width: 100%;
                height: 74; cursor: pointer;
                panel { layout: column; gap: 6;
                  text { class: t_body; text: "Share anonymous diagnostics"; }
                  text { class: t_faint; text: "Crash and performance counters. Nothing personal leaves the machine"; } }
                panel fr_chkbox1 { width: 22; height: 22; layout: column; justify: center;
                  align: center; background: #0a0a0a; border-color: #ffffff33; border-width: 1;
                  panel fr_chkmk1 { width: 10; height: 10; background: #ffffff; } } }
              panel { class: rule_dim; width: 100%; }
              panel fr_chk2 { layout: row; align: center; justify: space-between; width: 100%;
                height: 74; cursor: pointer;
                panel { layout: column; gap: 6;
                  text { class: t_body; text: "Check for updates on launch"; }
                  text { class: t_faint; text: "Engine and protocol releases"; } }
                panel fr_chkbox2 { width: 22; height: 22; layout: column; justify: center;
                  align: center; background: #0a0a0a; border-color: #ffffff33; border-width: 1;
                  panel fr_chkmk2 { width: 10; height: 10; background: #ffffff; } } }
              panel { class: rule; width: 100%; } }

            panel { layout: row; align: center; gap: 16; margin: 34 0 0 0;
              panel fr_next2 { height: 46; padding: 0 40 0 40; cursor: pointer;
                layout: row; align: center; justify: center; background: #e8e8e8;
                :hover { background: #ffffff; }
                text { font-size: 12; letter-spacing: 5; text-transform: uppercase;
                  color: #000000; text: "Continue"; } }
              panel fr_back2 { height: 46; padding: 0 24 0 24; cursor: pointer;
                layout: row; align: center; justify: center;
                background: #0a0a0a; border-color: #ffffff1c; border-width: 1;
                :hover { border-color: #ffffff8c; }
                text { font-size: 12; letter-spacing: 5; text-transform: uppercase;
                  color: #9a9a9a; text: "Back"; } } }
          }

          // ===================== 04 storage =====================
          panel fr_step3 { layout: column; width: 100%;
            text { class: t_micro; text: "Storage"; }
            text { class: t_h1; text: "Where mods live"; margin: 14 0 0 0; }
            text { class: t_body; color: #9a9a9a; margin: 26 0 0 0;
              text: "Downloaded modules and streamed assets are kept here, one"; }
            text { class: t_body; color: #9a9a9a; margin: 8 0 0 0;
              text: "folder per world, so a Skyrim module can never collide with a"; }
            text { class: t_body; color: #9a9a9a; margin: 8 0 0 0;
              text: "Starfield one."; }

            panel { layout: column; width: 100%; max-width: 860; margin: 36 0 0 0;
              text { class: t_micro; text: "Mods directory"; }
              panel { layout: row; align: end; gap: 20; width: 100%; margin: 16 0 0 0;
                panel { flex-grow: 1; layout: column;
                  text fr_modspath_t { font: mono; font-size: 14; color: #ffffff;
                    text: "~/.recreation/mods"; margin: 0 0 12 0; }
                  panel { width: 100%; height: 1; background: #ffffff33; } }
                panel fr_browse_mods { height: 34; padding: 0 18 0 18; cursor: pointer;
                  layout: row; align: center; justify: center;
                  background: #0a0a0a; border-color: #ffffff33; border-width: 1;
                  :hover { border-color: #ffffff; }
                  text { class: t_micro2; color: #9a9a9a; text: "Browse"; } } }

              panel { class: rule; width: 100%; margin: 40 0 0 0; }
              panel { layout: row; align: center; justify: space-between; width: 100%;
                height: 66;
                text { class: t_micro2; text: "Recommended free space"; }
                text fr_space { class: t_body; text: "50 GB"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; align: center; justify: space-between; width: 100%;
                height: 66;
                text { class: t_micro2; text: "Layout"; }
                text { class: t_body; text: "One folder per world"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; align: center; justify: space-between; width: 100%;
                height: 66;
                text { class: t_micro2; text: "Original game files"; }
                text { class: t_body; text: "Never written to"; } }
              panel { class: rule; width: 100%; } }

            panel { layout: row; align: center; gap: 16; margin: 34 0 0 0;
              panel fr_next3 { height: 46; padding: 0 40 0 40; cursor: pointer;
                layout: row; align: center; justify: center; background: #e8e8e8;
                :hover { background: #ffffff; }
                text { font-size: 12; letter-spacing: 5; text-transform: uppercase;
                  color: #000000; text: "Continue"; } }
              panel fr_back3 { height: 46; padding: 0 24 0 24; cursor: pointer;
                layout: row; align: center; justify: center;
                background: #0a0a0a; border-color: #ffffff1c; border-width: 1;
                :hover { border-color: #ffffff8c; }
                text { font-size: 12; letter-spacing: 5; text-transform: uppercase;
                  color: #9a9a9a; text: "Back"; } } }
          }

          // ===================== 05 ready =====================
          panel fr_step4 { layout: column; width: 100%;
            text { class: t_micro; text: "Ready"; }
            text { class: t_h1; text: "The way in is open"; margin: 14 0 0 0; }
            text { class: t_body; color: #9a9a9a; margin: 26 0 0 0;
              text: "This is what setup recorded. Change any of it later from the"; }
            text { class: t_body; color: #9a9a9a; margin: 8 0 0 0;
              text: "front screen under Settings."; }

            panel { layout: column; width: 100%; max-width: 940; margin: 36 0 0 0;
              panel { class: rule; width: 100%; }
              panel { layout: row; align: center; width: 100%; height: 68; gap: 22;
                panel { width: 5; height: 5; background: #ffffff; }
                text { class: t_micro2; width: 210; text: "Universes"; }
                text fr_sum_games { class: t_body; flex-grow: 1; text: "-"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; align: center; width: 100%; height: 68; gap: 22;
                panel { width: 5; height: 5; background: #ffffff; }
                text { class: t_micro2; width: 210; text: "Default play"; }
                text fr_sum_mode { class: t_body; flex-grow: 1; text: "-"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; align: center; width: 100%; height: 68; gap: 22;
                panel { width: 5; height: 5; background: #ffffff; }
                text { class: t_micro2; width: 210; text: "Mods"; }
                text fr_sum_mods { class: t_body; flex-grow: 1; text: "-"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; align: center; width: 100%; height: 68; gap: 22;
                panel { width: 5; height: 5; background: #ffffff; }
                text { class: t_micro2; width: 210; text: "Diagnostics"; }
                text fr_sum_diag { class: t_body; flex-grow: 1; text: "-"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; align: center; width: 100%; height: 68; gap: 22;
                panel { width: 5; height: 5; background: #ffffff; }
                text { class: t_micro2; width: 210; text: "Updates"; }
                text fr_sum_upd { class: t_body; flex-grow: 1; text: "-"; } }
              panel { class: rule; width: 100%; } }

            panel { layout: row; align: center; gap: 16; margin: 38 0 0 0;
              panel fr_launch { height: 52; padding: 0 52 0 52; cursor: pointer;
                layout: row; align: center; justify: center; background: #e8e8e8;
                :hover { background: #ffffff; }
                text { font-size: 13; letter-spacing: 6; text-transform: uppercase;
                  color: #000000; text: "Enter Recreation"; } }
              panel fr_back4 { height: 52; padding: 0 26 0 26; cursor: pointer;
                layout: row; align: center; justify: center;
                background: #0a0a0a; border-color: #ffffff1c; border-width: 1;
                :hover { border-color: #ffffff8c; }
                text { font-size: 12; letter-spacing: 5; text-transform: uppercase;
                  color: #9a9a9a; text: "Back"; } } }
          }
        }
      }

      // ===================== footer =====================
      panel { height: 88; layout: row; align: center; gap: 26; width: 100%;
        position: relative;
        panel { position: absolute; left: 0; right: 0; top: 0; height: 1; background: #ffffff1c; }
        text { font-size: 16; letter-spacing: 3; text-transform: uppercase;
          color: #ffffff; text: "Setup"; }
        text fr_footnote { font-size: 11; letter-spacing: 3; text-transform: uppercase;
          color: #5e5e5e; text: "Nothing is written until you finish"; }
        panel { flex-grow: 1; }
        panel { layout: row; align: center; gap: 30;
          panel { layout: row; align: center; gap: 11;
            panel { height: 26; padding: 0 7 0 7; layout: row; justify: center; align: center;
              background: #000000; border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "Enter"; } }
            text { font-size: 11; letter-spacing: 3; text-transform: uppercase;
              color: #5e5e5e; text: "Continue"; } }
          panel { layout: row; align: center; gap: 11;
            panel { height: 26; padding: 0 7 0 7; layout: row; justify: center; align: center;
              background: #000000; border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "Esc"; } }
            text { font-size: 11; letter-spacing: 3; text-transform: uppercase;
              color: #5e5e5e; text: "Back"; } } }
        text fr_build { font-size: 11; letter-spacing: 3; text-transform: uppercase;
          color: #5e5e5e; margin: 0 0 0 30; text: ""; }
      }
    }
  }
