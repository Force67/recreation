// The centre reticle. ch_dot is an accent site: GameUi recolours it per domain.

  panel crosshair {
    position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
    layout: column; justify: center; align: center;
    panel cross {
      width: 26; height: 26; position: relative;
      panel ch_t   { position: absolute; left: 12; top: 0;  width: 2; height: 8; background: #ffffffe0; }
      panel ch_b   { position: absolute; left: 12; top: 18; width: 2; height: 8; background: #ffffffe0; }
      panel ch_l   { position: absolute; left: 0;  top: 12; width: 8; height: 2; background: #ffffffe0; }
      panel ch_r   { position: absolute; left: 18; top: 12; width: 8; height: 2; background: #ffffffe0; }
      panel ch_dot { position: absolute; left: 12; top: 12; width: 2; height: 2; background: #ffffff; }
    }
  }
