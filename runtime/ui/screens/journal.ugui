// Quest journal, on the menu chassis. journal_q* (kJournalRows) are the quests
// and journal_obj* (kJournalObjRows) the selected quest's objectives, both
// fixed pools filled in GameUi::Build.

  panel journal_box {
    position: absolute; left: 0; top: 0; width: 100vw; height: 100vh;
    background: #000000e0; backdrop-blur: 26;
    panel journal_card { position: absolute; left: 130; right: 130; top: 76; bottom: 0;
      layout: column;
      panel { layout: row; align: end; justify: space-between; width: 100%;
        text journal_head { class: t_mast; text: "Journal"; }
        text journal_hint { class: t_micro2; text: "Press a number to track"; }
      }
      panel journal_rule { width: 100%; height: 1; margin: 26 0 0 0;
        background: #ffffff66; background-end: #ffffff00; gradient-angle: 90; }

      panel { flex-grow: 1; layout: row; align: stretch; width: 100%; padding: 44 0 0 0;
        panel { width: 520; layout: column;
          text { class: t_micro; text: "Active"; margin: 0 0 18 0; }
          text journal_q0 { class: t_h2; text: ""; margin: 0 0 14 0; }
          text journal_q1 { class: t_h2; text: ""; margin: 0 0 14 0; }
          text journal_q2 { class: t_h2; text: ""; margin: 0 0 14 0; }
          text journal_q3 { class: t_h2; text: ""; margin: 0 0 14 0; }
          text journal_q4 { class: t_h2; text: ""; margin: 0 0 14 0; }
          text journal_q5 { class: t_h2; text: ""; margin: 0 0 14 0; }
        }
        panel { width: 1; background: #ffffff1c; }
        panel { flex-grow: 1; layout: column; padding: 0 0 0 56;
          text { class: t_micro; text: "Objectives"; margin: 0 0 18 0; }
          text journal_obj0 { class: t_body; text: ""; margin: 0 0 10 0; }
          text journal_obj1 { class: t_body; text: ""; margin: 0 0 10 0; }
          text journal_obj2 { class: t_dim; text: ""; margin: 0 0 10 0; }
          text journal_obj3 { class: t_dim; text: ""; margin: 0 0 10 0; }
          text journal_obj4 { class: t_faint; text: ""; margin: 0 0 10 0; }
          text journal_obj5 { class: t_faint; text: ""; margin: 0 0 10 0; }
        }
      }
      panel { height: 96; layout: row; align: center; gap: 44; width: 100%;
        panel { position: absolute; left: 0; right: 0; top: 0; height: 1; background: #ffffff1c; }
        ui_hint { k: "J"; a: "Close"; }
      }
    }
  }
