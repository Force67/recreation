// RECREATION legal notice: the card shown before anything else on startup, in
// the spirit of the plain legal/health screens the games themselves boot with.
// Austere on purpose - near-black field, no chrome - so it reads as a boot card
// rather than as a menu. The same notice is tiled in six languages so there is
// no reading of it as small print.
//
// ugui text does not wrap, so every line of every tile is its own text widget.
// A tile sets `align: start` because a column's default is stretch, which would
// pull the short rule under each language label out to the full tile width.
//
// Drives the widgets GameUi expects: legal (root), legal_count (the countdown).

  panel legal {
    position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; background: #05070b;
    layout: column; justify: center; align: center;

    panel { layout: column; align: center;

      // ===================== wordmark =====================
      text { text: "RECREATION"; font-size: 42; color: #eef2fb; letter-spacing: 11; }
      text { text: "AN INDEPENDENT REIMPLEMENTATION"; font-size: 12; color: #6a7484;
             letter-spacing: 5; margin: 14 0 0 0; }
      panel { width: 140; height: 1; background: #ffffff24; margin: 30 0 0 0; }

      // ===================== the notice, six ways =====================
      panel { layout: column; margin: 46 0 0 0;

        panel { layout: row; margin: 0 0 22 0;

          panel { layout: column; align: start; width: 580; background: #0a0e15;
                  border-width: 1; border-color: #ffffff12; corner-radius: 2;
                  padding: 22 26 24 26; margin: 0 22 0 0;
            text { text: "ENGLISH"; font-size: 11; color: #7f8b9e; letter-spacing: 4; }
            panel { width: 26; height: 1; background: #ffffff1c; margin: 9 0 13 0; }
            text { text: "Not affiliated with, authorised by or endorsed by Bethesda Softworks";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "LLC or ZeniMax Media Inc. No Bethesda source code was used in making";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "this software. No game content is included: you must own a legitimate";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "copy of any game you load.";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
          }

          panel { layout: column; align: start; width: 580; background: #0a0e15;
                  border-width: 1; border-color: #ffffff12; corner-radius: 2;
                  padding: 22 26 24 26; margin: 0 22 0 0;
            text { text: "FRANÇAIS"; font-size: 11; color: #7f8b9e; letter-spacing: 4; }
            panel { width: 26; height: 1; background: #ffffff1c; margin: 9 0 13 0; }
            text { text: "Sans affiliation, autorisation ni approbation de Bethesda Softworks";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "LLC ou ZeniMax Media Inc. Aucun code source Bethesda n'a été utilisé.";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "Aucun contenu de jeu n'est inclus : vous devez posséder une copie";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "légitime de chaque jeu que vous chargez.";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
          }

          panel { layout: column; align: start; width: 580; background: #0a0e15;
                  border-width: 1; border-color: #ffffff12; corner-radius: 2;
                  padding: 22 26 24 26;
            text { text: "DEUTSCH"; font-size: 11; color: #7f8b9e; letter-spacing: 4; }
            panel { width: 26; height: 1; background: #ffffff1c; margin: 9 0 13 0; }
            text { text: "Nicht verbunden mit, autorisiert oder unterstützt von Bethesda";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "Softworks LLC oder ZeniMax Media Inc. Es wurde kein Bethesda-";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "Quellcode verwendet. Keine Spielinhalte enthalten: Sie müssen eine";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "rechtmäßige Kopie jedes geladenen Spiels besitzen.";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
          }
        }

        panel { layout: row;

          panel { layout: column; align: start; width: 580; background: #0a0e15;
                  border-width: 1; border-color: #ffffff12; corner-radius: 2;
                  padding: 22 26 24 26; margin: 0 22 0 0;
            text { text: "ITALIANO"; font-size: 11; color: #7f8b9e; letter-spacing: 4; }
            panel { width: 26; height: 1; background: #ffffff1c; margin: 9 0 13 0; }
            text { text: "Non affiliato, autorizzato né approvato da Bethesda Softworks LLC";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "o ZeniMax Media Inc. Non è stato usato alcun codice sorgente";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "Bethesda. Nessun contenuto di gioco è incluso: devi possedere una";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "copia legittima di ogni gioco che carichi.";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
          }

          panel { layout: column; align: start; width: 580; background: #0a0e15;
                  border-width: 1; border-color: #ffffff12; corner-radius: 2;
                  padding: 22 26 24 26; margin: 0 22 0 0;
            text { text: "ESPAÑOL"; font-size: 11; color: #7f8b9e; letter-spacing: 4; }
            panel { width: 26; height: 1; background: #ffffff1c; margin: 9 0 13 0; }
            text { text: "Sin afiliación, autorización ni respaldo de Bethesda Softworks LLC";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "o ZeniMax Media Inc. No se ha utilizado código fuente de Bethesda.";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "No se incluye contenido del juego: debes poseer una copia legítima";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "de cada juego que cargues.";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
          }

          panel { layout: column; align: start; width: 580; background: #0a0e15;
                  border-width: 1; border-color: #ffffff12; corner-radius: 2;
                  padding: 22 26 24 26;
            text { text: "POLSKI"; font-size: 11; color: #7f8b9e; letter-spacing: 4; }
            panel { width: 26; height: 1; background: #ffffff1c; margin: 9 0 13 0; }
            text { text: "Bez powiązania, autoryzacji ani poparcia ze strony Bethesda Softworks";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "LLC lub ZeniMax Media Inc. Nie użyto kodu źródłowego Bethesda.";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "Nie dołączono zawartości gry: musisz posiadać legalną kopię każdej";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
            text { text: "uruchamianej gry.";
                   font-size: 13; color: #8791a1; line-height: 1.22; }
          }
        }
      }

      // ===================== dismiss prompt =====================
      panel { layout: row; align: center; justify: center; gap: 20; margin: 50 0 0 0;
        text { text: "PRESS ANY KEY TO CONTINUE"; font-size: 13; color: #6b7686; letter-spacing: 5; }
        panel { border-width: 1; border-color: #ffffff1c; corner-radius: 3; padding: 3 9 3 9;
          text legal_count { text: "5"; font-size: 13; color: #7f8998; letter-spacing: 2; }
        }
      }
    }
  }
