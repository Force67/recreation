          panel { layout: row; justify: space-between; align: center; width: 100%;
            max-width: 640; height: 44;
            text { class: t_micro2; text: "Build"; }
            text mm_pf_build { class: t_body; text: "-"; } }

          panel mm_pf_char { layout: column; width: 100%; max-width: 640; margin: 26 0 0 0;
            panel { layout: row; align: center; gap: 16; margin: 0 0 10 0;
              text { class: t_micro2; text: "Health"; width: 74; }
              ui_meter mm_pf_health { flex-grow: 1; w: 100%; h: 9; } }
            panel { layout: row; align: center; gap: 16; margin: 0 0 10 0;
              text { class: t_micro2; text: "Magicka"; width: 74; }
              ui_meter mm_pf_magicka { flex-grow: 1; w: 100%; h: 9; } }
            panel { layout: row; align: center; gap: 16; margin: 0 0 18 0;
              text { class: t_micro2; text: "Stamina"; width: 74; }
              ui_meter mm_pf_stamina { flex-grow: 1; w: 100%; h: 9; } }
            panel { layout: row; justify: space-between; align: center; width: 100%;
              height: 44;
              text { class: t_micro2; text: "Gold"; }
              text mm_pf_gold { class: t_body; text: "-"; } }
            panel { class: rule_dim; width: 100%; }
            panel { layout: row; justify: space-between; align: center; width: 100%;
              height: 44;
              text { class: t_micro2; text: "Quests"; }
              text mm_pf_quests { class: t_body; text: "-"; } }
            panel { class: rule_dim; width: 100%; }
            panel { layout: row; justify: space-between; align: center; width: 100%;
              height: 44;
              text { class: t_micro2; text: "Location"; }
              text mm_pf_loc { class: t_body; text: "-"; } }
          }
          text mm_pf_hint { class: t_faint; text: "Enter a universe to load a character.";
            margin: 18 0 0 0; }
        }


        // LOAD. The Mods screen's shape, because it is the same shape of
        // problem: many rows, one selected, the facts about it on the right.
        // Worlds are tabs, never a nested list, so only one selection marker is
        // ever on screen. The card leads with the screenshot the .ess itself
        // carries, and ends with the load-order verdict, which is the fact that
        // decides whether resuming works at all.
        panel mm_body_load { layout: column; width: 100%; flex-grow: 1;
          panel { layout: row; align: center; justify: space-between; width: 100%;
            panel { layout: row; align: center; gap: 34;
              panel mm_ld_tab0 { cursor: pointer; padding: 0 0 9 0; position: relative;
                text mm_ld_tab0_t { font-size: 11; letter-spacing: 4;
                  text-transform: uppercase; color: #5e5e5e; text: ""; }
                panel mm_ld_tab0_r { position: absolute; left: 0; right: 0; bottom: 0;
                  height: 2; background: #ffffff; } }
              panel mm_ld_tab1 { cursor: pointer; padding: 0 0 9 0; position: relative;
                text mm_ld_tab1_t { font-size: 11; letter-spacing: 4;
                  text-transform: uppercase; color: #5e5e5e; text: ""; }
                panel mm_ld_tab1_r { position: absolute; left: 0; right: 0; bottom: 0;
                  height: 2; background: #ffffff; } }
              panel mm_ld_tab2 { cursor: pointer; padding: 0 0 9 0; position: relative;
                text mm_ld_tab2_t { font-size: 11; letter-spacing: 4;
                  text-transform: uppercase; color: #5e5e5e; text: ""; }
                panel mm_ld_tab2_r { position: absolute; left: 0; right: 0; bottom: 0;
                  height: 2; background: #ffffff; } } }
            text mm_ld_count { class: t_micro2; text: ""; } }

          panel { layout: row; gap: 40; width: 100%; flex-grow: 1; margin: 22 0 0 0;
            panel { layout: column; flex-grow: 1;
              panel { layout: row; align: center; height: 30; width: 100%;
                text { width: 26; class: t_micro2; font-size: 9; text: ""; }
                text { width: 64; class: t_micro2; font-size: 9; text: "No"; }
                text { width: 210; class: t_micro2; font-size: 9; text: "Character"; }
                text { width: 64; class: t_micro2; font-size: 9; text: "Lvl"; }
                text { flex-grow: 1; class: t_micro2; font-size: 9; text: "Location"; }
                text { width: 96; class: t_micro2; font-size: 9; text: "Played"; }
                text { width: 132; class: t_micro2; font-size: 9; text: "Saved"; }
                panel { width: 210; layout: row; justify: end;
                  text mm_ld_colstate { class: t_micro2; font-size: 9; text: ""; } } }
              panel { class: rule; width: 100%; }
              ui_save_row mm_ld0 { }
              ui_save_row mm_ld1 { }
              ui_save_row mm_ld2 { }
              ui_save_row mm_ld3 { }
              ui_save_row mm_ld4 { }
              ui_save_row mm_ld5 { }
              ui_save_row mm_ld6 { }
              ui_save_row mm_ld7 { }
              ui_save_row mm_ld8 { }
              ui_save_row mm_ld9 { }
              ui_save_row mm_ld10 { }
              ui_save_row mm_ld11 { }
              text mm_ld_empty { class: t_faint; margin: 20 0 0 0;
                text: "No savegames found."; }
              panel { flex-grow: 1; }
              panel mm_ld_statusrow { layout: row; align: center; gap: 14; width: 100%;
                panel { width: 5; height: 5; background: #ffffff; }
                text mm_ld_status { class: t_micro2; text: ""; } } }

            panel { width: 1; background: #ffffff1c; }

            panel mm_ld_card { width: 394; layout: column;
              image mm_ld_shot { width: 394; height: 222; }
              panel mm_ld_noshot { width: 394; height: 222; layout: row; justify: center;
                align: center; background: #08090b; border-color: #ffffff1c; border-width: 1;
                text { class: t_micro2; text: "No screenshot"; } }
              text mm_ld_micro { class: t_micro2; font-size: 9; margin: 22 0 0 0; text: ""; }
              text mm_ld_name { font-size: 26; letter-spacing: 2; color: #ffffff;
                margin: 10 0 0 0; text: ""; }
              text mm_ld_sub { class: t_faint; font-size: 12; margin: 8 0 0 0; text: ""; }

              panel { layout: column; width: 100%; margin: 20 0 0 0;
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "Saved"; }
                  text mm_ld_kv0 { class: t_body; font-size: 12; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "Played"; }
                  text mm_ld_kv1 { class: t_body; font-size: 12; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "Location"; }
                  text mm_ld_kv2 { class: t_body; font-size: 12; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "File"; }
                  text mm_ld_kv3 { class: t_body; font-size: 12; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "Size"; }
                  text mm_ld_kv4 { class: t_body; font-size: 12; text: "-"; } } }

              text mm_ld_order { class: t_micro2; font-size: 9; margin: 24 0 0 0; text: ""; }
              panel mm_ld_dep0 { layout: row; align: center; height: 30; gap: 12; width: 100%;
                panel mm_ld_dp0 { width: 5; height: 5; background: #ffffff; }
                text mm_ld_dn0 { flex-grow: 1; font-size: 12; color: #9a9a9a; text: ""; }
                text mm_ld_ds0 { class: t_micro2; font-size: 9; text: ""; } }
              panel mm_ld_dep1 { layout: row; align: center; height: 30; gap: 12; width: 100%;
                panel mm_ld_dp1 { width: 5; height: 5; background: #ffffff; }
                text mm_ld_dn1 { flex-grow: 1; font-size: 12; color: #9a9a9a; text: ""; }
                text mm_ld_ds1 { class: t_micro2; font-size: 9; text: ""; } }
              panel mm_ld_dep2 { layout: row; align: center; height: 30; gap: 12; width: 100%;
                panel mm_ld_dp2 { width: 5; height: 5; background: #ffffff; }
                text mm_ld_dn2 { flex-grow: 1; font-size: 12; color: #9a9a9a; text: ""; }
                text mm_ld_ds2 { class: t_micro2; font-size: 9; text: ""; } }
              panel mm_ld_dep3 { layout: row; align: center; height: 30; gap: 12; width: 100%;
                panel mm_ld_dp3 { width: 5; height: 5; background: #ffffff; }
                text mm_ld_dn3 { flex-grow: 1; font-size: 12; color: #9a9a9a; text: ""; }
                text mm_ld_ds3 { class: t_micro2; font-size: 9; text: ""; } }

              panel { layout: row; gap: 14; margin: 26 0 0 0;
                panel mm_ld_resume { height: 46; padding: 0 30; layout: row; justify: center;
                  align: center; cursor: pointer; background: #ffffff;
                  :hover { background: #e0e0e0; }
                  text mm_ld_resume_t { font-size: 11; letter-spacing: 4;
                    text-transform: uppercase; color: #000000; text: "Resume"; } }
                panel mm_ld_file { height: 46; padding: 0 30; layout: row; justify: center;
                  align: center; cursor: pointer; background: #060606;
                  border-color: #ffffff33; border-width: 1;
                  :hover { border-color: #ffffff; }
                  text { font-size: 11; letter-spacing: 4; text-transform: uppercase;
                    color: #9a9a9a; text: "Show file"; } } } } }
        }


        // JOIN. Other people's worlds, all of them, in one list: a friend's coop
        // session and a 128-slot server are the same act from this side, and the
        // gametype column is the whole difference. The card's last block is what
        // stands between the player and the world, which for coop is the host's
        // load order and for a server is what it will stream.
        panel mm_body_join { layout: column; width: 100%; flex-grow: 1;
          panel { layout: row; align: center; justify: space-between; width: 100%;
            panel { layout: row; align: center; gap: 34;
              panel mm_jn_tab0 { cursor: pointer; padding: 0 0 9 0; position: relative;
                text mm_jn_tab0_t { font-size: 11; letter-spacing: 4;
                  text-transform: uppercase; color: #5e5e5e; text: "All"; }
                panel mm_jn_tab0_r { position: absolute; left: 0; right: 0; bottom: 0;
                  height: 2; background: #ffffff; } }
              panel mm_jn_tab1 { cursor: pointer; padding: 0 0 9 0; position: relative;
                text mm_jn_tab1_t { font-size: 11; letter-spacing: 4;
                  text-transform: uppercase; color: #5e5e5e; text: "Friends"; }
                panel mm_jn_tab1_r { position: absolute; left: 0; right: 0; bottom: 0;
                  height: 2; background: #ffffff; } }
              panel mm_jn_tab2 { cursor: pointer; padding: 0 0 9 0; position: relative;
                text mm_jn_tab2_t { font-size: 11; letter-spacing: 4;
                  text-transform: uppercase; color: #5e5e5e; text: "Favourites"; }
                panel mm_jn_tab2_r { position: absolute; left: 0; right: 0; bottom: 0;
                  height: 2; background: #ffffff; } }
              panel mm_jn_tab3 { cursor: pointer; padding: 0 0 9 0; position: relative;
                text mm_jn_tab3_t { font-size: 11; letter-spacing: 4;
                  text-transform: uppercase; color: #5e5e5e; text: "History"; }
                panel mm_jn_tab3_r { position: absolute; left: 0; right: 0; bottom: 0;
                  height: 2; background: #ffffff; } }
              panel mm_jn_tab4 { cursor: pointer; padding: 0 0 9 0; position: relative;
                text mm_jn_tab4_t { font-size: 11; letter-spacing: 4;
                  text-transform: uppercase; color: #5e5e5e; text: "Direct"; }
                panel mm_jn_tab4_r { position: absolute; left: 0; right: 0; bottom: 0;
                  height: 2; background: #ffffff; } } }
            text mm_jn_count { class: t_micro2; text: ""; } }

          panel { layout: row; gap: 40; width: 100%; flex-grow: 1; margin: 22 0 0 0;
            panel { layout: column; flex-grow: 1;
              panel { layout: row; align: center; height: 30; width: 100%;
                text { width: 26; class: t_micro2; font-size: 9; text: ""; }
                text { flex-grow: 1; class: t_micro2; font-size: 9; text: "Session"; }
                text { width: 126; class: t_micro2; font-size: 9; text: "World"; }
                text { width: 196; class: t_micro2; font-size: 9; text: "Gametype"; }
                text { width: 96; class: t_micro2; font-size: 9; text: "Players"; }
                text { width: 82; class: t_micro2; font-size: 9; text: "Ping"; }
                panel { width: 196; layout: row; justify: end;
                  text { class: t_micro2; font-size: 9; text: "Entry"; } } }
              panel { class: rule; width: 100%; }
              ui_server_row mm_jn0 { }
              ui_server_row mm_jn1 { }
              ui_server_row mm_jn2 { }
              ui_server_row mm_jn3 { }
              ui_server_row mm_jn4 { }
              ui_server_row mm_jn5 { }
              ui_server_row mm_jn6 { }
              ui_server_row mm_jn7 { }
              ui_server_row mm_jn8 { }
              ui_server_row mm_jn9 { }
              ui_server_row mm_jn10 { }
              ui_server_row mm_jn11 { }
              text mm_jn_empty { class: t_faint; margin: 20 0 0 0;
                text: "Nothing listed. No sessions match this filter."; }
              panel { flex-grow: 1; }
              panel mm_jn_statusrow { layout: row; align: center; gap: 14; width: 100%;
                panel { width: 5; height: 5; background: #ffffff; }
                text mm_jn_status { class: t_micro2; text: ""; } } }

            panel { width: 1; background: #ffffff1c; }

            panel mm_jn_card { width: 394; layout: column;
              image mm_jn_shot { width: 394; height: 222; }
              panel mm_jn_noshot { width: 394; height: 222; layout: row; justify: center;
                align: center; background: #08090b; border-color: #ffffff1c; border-width: 1;
                text { class: t_micro2; text: "No preview"; } }
              text mm_jn_micro { class: t_micro2; font-size: 9; margin: 22 0 0 0; text: ""; }
              text mm_jn_name { font-size: 26; letter-spacing: 2; color: #ffffff;
                margin: 10 0 0 0; text: ""; }
              text mm_jn_sub { class: t_faint; font-size: 12; margin: 8 0 0 0; text: ""; }

              panel { layout: column; width: 100%; margin: 20 0 0 0;
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "Host"; }
                  text mm_jn_kv0 { class: t_body; font-size: 12; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "World"; }
                  text mm_jn_kv1 { class: t_body; font-size: 12; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "You arrive as"; }
                  text mm_jn_kv2 { class: t_body; font-size: 12; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "Progress"; }
                  text mm_jn_kv3 { class: t_body; font-size: 12; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; align: center; justify: space-between; height: 34;
                  text { class: t_micro2; font-size: 9; text: "Players"; }
                  text mm_jn_kv4 { class: t_body; font-size: 12; text: "-"; } } }

              text mm_jn_order { class: t_micro2; font-size: 9; margin: 24 0 0 0; text: ""; }
              panel mm_jn_dep0 { layout: row; align: center; height: 30; gap: 12; width: 100%;
                panel mm_jn_dp0 { width: 5; height: 5; background: #ffffff; }
                text mm_jn_dn0 { flex-grow: 1; font-size: 12; color: #9a9a9a; text: ""; }
                text mm_jn_ds0 { class: t_micro2; font-size: 9; text: ""; } }
              panel mm_jn_dep1 { layout: row; align: center; height: 30; gap: 12; width: 100%;
                panel mm_jn_dp1 { width: 5; height: 5; background: #ffffff; }
                text mm_jn_dn1 { flex-grow: 1; font-size: 12; color: #9a9a9a; text: ""; }
                text mm_jn_ds1 { class: t_micro2; font-size: 9; text: ""; } }
              panel mm_jn_dep2 { layout: row; align: center; height: 30; gap: 12; width: 100%;
                panel mm_jn_dp2 { width: 5; height: 5; background: #ffffff; }
                text mm_jn_dn2 { flex-grow: 1; font-size: 12; color: #9a9a9a; text: ""; }
                text mm_jn_ds2 { class: t_micro2; font-size: 9; text: ""; } }
              panel mm_jn_dep3 { layout: row; align: center; height: 30; gap: 12; width: 100%;
                panel mm_jn_dp3 { width: 5; height: 5; background: #ffffff; }
                text mm_jn_dn3 { flex-grow: 1; font-size: 12; color: #9a9a9a; text: ""; }
                text mm_jn_ds3 { class: t_micro2; font-size: 9; text: ""; } }

              panel { layout: row; gap: 14; margin: 26 0 0 0;
                panel mm_jn_join { height: 46; padding: 0 30; layout: row; justify: center;
                  align: center; cursor: pointer; background: #ffffff;
                  :hover { background: #e0e0e0; }
                  text mm_jn_join_t { font-size: 11; letter-spacing: 4;
                    text-transform: uppercase; color: #000000; text: "Join"; } }
                panel mm_jn_char { height: 46; padding: 0 30; layout: row; justify: center;
                  align: center; cursor: pointer; background: #060606;
                  border-color: #ffffff33; border-width: 1;
                  :hover { border-color: #ffffff; }
                  text { font-size: 11; letter-spacing: 4; text-transform: uppercase;
                    color: #9a9a9a; text: "Character"; } } } } }
        }
      }
    }
  }
