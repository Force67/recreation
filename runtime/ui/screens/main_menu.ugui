          panel { position: absolute; left: 0; right: 0; bottom: 0; height: 177;
            background: #00000000; background-end: #000000f2; gradient-angle: 180; }
          panel mm_top7 { position: absolute; left: 0; right: 0; top: 0; height: 2;
            background: #ffffff; }
          panel { position: absolute; left: 18; top: 20; layout: column; gap: 3;
            panel mm_sp70 { width: 22; height: 2; background: #ffffff3d; }
            panel mm_sp71 { width: 14; height: 2; background: #ffffff3d; }
            panel mm_sp72 { width: 26; height: 2; background: #ffffff3d; }
            panel mm_sp73 { width: 11; height: 2; background: #ffffff3d; }
            panel mm_sp74 { width: 19; height: 2; background: #ffffff3d; }
            panel mm_sp75 { width: 24; height: 2; background: #ffffff3d; }
            panel mm_sp76 { width: 9; height: 2; background: #ffffff3d; }
            panel mm_sp77 { width: 17; height: 2; background: #ffffff3d; }
            panel mm_sp78 { width: 13; height: 2; background: #ffffff3d; }
            panel mm_sp79 { width: 21; height: 2; background: #ffffff3d; }
          }
          text mm_state7 { position: absolute; right: 16; top: 16; font-size: 9;
            letter-spacing: 3; text-transform: uppercase; color: #ffffff8c; text: ""; }
          panel { position: absolute; left: 18; right: 86; bottom: 16; layout: column;
            text mm_kind7 { font-size: 9; letter-spacing: 3; text-transform: uppercase;
              color: #ffffff8c; text: ""; }
            text mm_title7 { font-size: 22; letter-spacing: 4; text-transform: uppercase;
              color: #ffffffcc; margin: 8 0 0 0; text: ""; }
            text mm_detail7 { font-size: 11; letter-spacing: 1; color: #ffffff7a;
              margin: 7 0 0 0; text: ""; } }
          panel mm_play7 { position: absolute; right: 16; bottom: 16; width: 46; height: 46;
            layout: row; justify: center; align: center; cursor: pointer;
            background: #060606; border-color: #ffffff33; border-width: 1;
            panel { width: 10; height: 19; overflow: hidden; position: relative;
              panel mm_tri7 { position: absolute; left: -6; top: 3; width: 13; height: 13;
                background: #ffffffcc; rotation: 45; } } } }
      }

      // The save rail: the focused tile's world, its recent moments. It lives in
      // the space the grid already left empty, collapses whole when that world
      // has no saves, and ALL SAVES opens the Load screen for everything six
      // cards cannot hold.
      panel mm_rail { layout: column; width: 100%; margin: 26 0 0 0;
        panel { layout: row; align: center; justify: space-between; width: 100%;
          panel { layout: row; align: center; gap: 14;
            text mm_rail_head { font-size: 11; letter-spacing: 5;
              text-transform: uppercase; color: #ffffff; text: "Continue"; }
            text mm_rail_sub { class: t_micro2; text: ""; } }
          panel { layout: row; align: center; gap: 20;
            text mm_rail_count { class: t_micro2; text: ""; }
            panel mm_rail_all { cursor: pointer; padding: 7 14; background: #060606;
              border-color: #ffffff33; border-width: 1;
              :hover { border-color: #ffffff; }
              text { font-size: 10; letter-spacing: 3; text-transform: uppercase;
                color: #9a9a9a; text: "All saves"; } } } }
        panel { layout: row; gap: 18; margin: 12 0 0 0;
          ui_save_card mm_sv0 { }
          ui_save_card mm_sv1 { }
          ui_save_card mm_sv2 { }
          ui_save_card mm_sv3 { }
          ui_save_card mm_sv4 { }
          ui_save_card mm_sv5 { } } }

      panel { flex-grow: 1; }

      panel { height: 88; layout: row; align: center; gap: 26; width: 100%;
        position: relative;
        panel { position: absolute; left: 0; right: 0; top: 0; height: 1; background: #ffffff1c; }
        text mm_pname { font-size: 16; letter-spacing: 3; text-transform: uppercase;
          color: #ffffff; text: "Wanderer"; }
        text mm_psys { font-size: 11; letter-spacing: 3; text-transform: uppercase;
          color: #5e5e5e; text: ""; }
        panel mm_pnet { layout: row; align: center; gap: 10;
          image gl_peers { width: 20; height: 14; }
          text mm_pcount { class: t_micro2; text: "0"; } }
        // The footer used to report the session as the word "Offline". With the
        // segment above it, it carries the live one: slots, invite code, address.
        text mm_sess_line { class: t_micro2; text: ""; }
        panel { flex-grow: 1; }
        panel { layout: row; align: center; gap: 30;
          panel { layout: row; align: center; gap: 11;
            panel { width: 26; height: 26; layout: row; justify: center; align: center;
              border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "<>"; } }
            text { font-size: 11; letter-spacing: 3; text-transform: uppercase;
              color: #5e5e5e; text: "Move"; } }
          panel { layout: row; align: center; gap: 11;
            panel { width: 26; height: 26; layout: row; justify: center; align: center;
              border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "Q"; } }
            panel { width: 26; height: 26; layout: row; justify: center; align: center;
              border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "E"; } }
            text { font-size: 11; letter-spacing: 3; text-transform: uppercase;
              color: #5e5e5e; text: "Page"; } }
          panel { layout: row; align: center; gap: 11;
            panel { height: 26; padding: 0 7; layout: row; justify: center; align: center;
              border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "Enter"; } }
            text { font-size: 11; letter-spacing: 3; text-transform: uppercase;
              color: #5e5e5e; text: "Play"; } } }
        text mm_build { font-size: 11; letter-spacing: 3; text-transform: uppercase;
          color: #5e5e5e; margin: 0 0 0 30; text: ""; }
      }

      panel mm_screen { position: absolute; left: 0; top: 92; right: 0; bottom: 88;
        background: #000000; layout: column;
        panel { layout: row; align: center; justify: space-between; width: 100%;
          text mm_screen_title { class: t_micro; text: "Multiplayer"; color: #ffffff; }
          panel mm_back { cursor: pointer; padding: 8 14; border-color: #ffffff33;
            border-width: 1;
            :hover { border-color: #ffffff; }
            text { class: t_micro2; text: "Back"; } } }
        panel { class: rule; width: 100%; margin: 16 0 26 0; }


        panel mm_body_mp { layout: column; width: 100%;
          text { class: t_micro; text: "Session"; }
          text mm_mp_universe { class: t_h2; text: "Skyrim"; color: #ffffff; margin: 12 0 0 0; }
          panel { layout: row; gap: 20; margin: 22 0 0 0;
            panel mm_mp_host { width: 328; position: relative; cursor: pointer;
              layout: column; padding: 24; border-color: #ffffff8c; border-width: 1;
              background: #101215;
              :hover { background: #16191d; }
              panel { position: absolute; left: 0; right: 0; top: 0; height: 2;
                background: #ffffff; }
              text { class: t_h2; text: "Host"; font-size: 17; letter-spacing: 4;
                text-transform: uppercase; color: #ffffff; }
              text { class: t_faint; text: "Open this world to others";
                margin: 12 0 0 0; } }
            panel mm_mp_join { width: 328; cursor: pointer; layout: column; padding: 24;
              border-color: #ffffff1c; border-width: 1; background: #08090b;
              :hover { border-color: #ffffff8c; }
              text { class: t_h2; text: "Join"; font-size: 17; letter-spacing: 4;
                text-transform: uppercase; }
              text { class: t_faint; text: "Connect to a running session";
                margin: 12 0 0 0; } } }
          text { class: t_micro2; text: "Listen address"; margin: 26 0 8 0; }
          panel { width: 676; height: 40; layout: column; justify: center;
            text mm_mp_addr { class: t_body; text: "127.0.0.1:29700"; } }
          panel { width: 676; height: 1; background: #ffffff33; }
          text mm_mp_status { class: t_micro2; text: "Offline"; margin: 20 0 0 0; }
        }


        panel mm_body_mods { layout: column; width: 100%;
          text mm_mods_head { class: t_micro; text: "Modules"; }
          panel mm_mods_list { layout: column; width: 100%; max-width: 1040;
