// The front-end, on the same chassis as the pause menu. PLAY's detail is the
// universe chooser: mm_bg* is the art slot GameUi binds a texture to, mm_sel*
// the 2px rule marking selection, mm_labt* the name.
//
// mm_screen is a sub-page filling the detail column, not a full overlay, so the
// nav list stays standing. GameUi toggles it and mm_body_* unchanged.

  panel mainmenu {
    position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; background: #000000;
    panel { position: absolute; left: 0; top: 0; right: 0; bottom: 0;
      background: #0e1013; background-end: #000000; gradient-angle: 180; }

    panel { position: absolute; left: 130; right: 130; top: 76; bottom: 0; layout: column;

      panel { layout: row; align: end; justify: space-between; width: 100%;
        text { class: t_mast; text: "Recreation"; }
        panel { layout: column; align: end; gap: 8;
          text mm_build { class: t_micro2; text: ""; color: #9a9a9a; }
          text mm_psys { class: t_micro2; text: ""; }
        }
      }
      panel { width: 100%; height: 1; margin: 26 0 0 0;
        background: #ffffff66; background-end: #ffffff00; gradient-angle: 90; }

      panel { flex-grow: 1; layout: row; align: stretch; width: 100%; padding: 48 0 0 0;

        panel { width: 430; layout: column;
          panel mm_nav0 { position: relative; layout: column; justify: center; height: 78;
            padding: 0 0 0 26; cursor: pointer;
            :hover { background: #ffffff14; } :selected { background: #ffffff12; }
            panel mm_caret0 { position: absolute; left: 0; top: 18; bottom: 18; width: 3;
              background: #ffffff; }
            text mm_navt0 { class: t_h2; text: "Play"; color: #ffffff; }
            text mm_navs0 { class: t_faint; text: "Choose your universe"; margin: 6 0 0 0; } }
          panel mm_nav1 { position: relative; layout: column; justify: center; height: 78;
            padding: 0 0 0 26; cursor: pointer;
            :hover { background: #ffffff14; } :selected { background: #ffffff12; }
            panel mm_caret1 { position: absolute; left: 0; top: 18; bottom: 18; width: 3;
              background: #ffffff; }
            text mm_navt1 { class: t_h2; text: "Multiplayer"; }
            text mm_navs1 { class: t_faint; text: "Host or join a session"; margin: 6 0 0 0; } }
          panel mm_nav2 { position: relative; layout: column; justify: center; height: 78;
            padding: 0 0 0 26; cursor: pointer;
            :hover { background: #ffffff14; } :selected { background: #ffffff12; }
            panel mm_caret2 { position: absolute; left: 0; top: 18; bottom: 18; width: 3;
              background: #ffffff; }
            text mm_navt2 { class: t_h2; text: "Mods"; }
            text mm_navs2 { class: t_faint; text: "Gameplay modules"; margin: 6 0 0 0; } }
          panel mm_nav3 { position: relative; layout: column; justify: center; height: 78;
            padding: 0 0 0 26; cursor: pointer;
            :hover { background: #ffffff14; } :selected { background: #ffffff12; }
            panel mm_caret3 { position: absolute; left: 0; top: 18; bottom: 18; width: 3;
              background: #ffffff; }
            text mm_navt3 { class: t_h2; text: "Settings"; }
            text mm_navs3 { class: t_faint; text: "Controls and display"; margin: 6 0 0 0; } }
          panel mm_nav4 { position: relative; layout: column; justify: center; height: 78;
            padding: 0 0 0 26; cursor: pointer;
            :hover { background: #ffffff14; } :selected { background: #ffffff12; }
            panel mm_caret4 { position: absolute; left: 0; top: 18; bottom: 18; width: 3;
              background: #ffffff; }
            text mm_navt4 { class: t_h2; text: "Profile"; }
            text mm_navs4 { class: t_faint; text: "Character and account"; margin: 6 0 0 0; } }
          panel mm_nav5 { position: relative; layout: column; justify: center; height: 78;
            padding: 0 0 0 26; cursor: pointer;
            :hover { background: #ffffff14; } :selected { background: #ffffff12; }
            panel mm_caret5 { position: absolute; left: 0; top: 18; bottom: 18; width: 3;
              background: #ffffff; }
            text mm_navt5 { class: t_h2; text: "Quit"; }
            text mm_navs5 { class: t_faint; text: "Exit to desktop"; margin: 6 0 0 0; } }
        }

        panel { width: 1; background: #ffffff1c; }

        panel { flex-grow: 1; position: relative; layout: column; padding: 2 0 0 56;

          text { class: t_micro; text: "Universe"; }
          panel { layout: row; gap: 20; margin: 26 0 0 0;
            panel mm_col0 { width: 328; position: relative; layout: column; cursor: pointer;
              border-color: #ffffff1c; border-width: 1; background: #08090b;
              :hover { border-color: #ffffff8c; background: #101215; }
              panel mm_sel0 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                background: #ffffff; }
              // the art block holds its height whether or not a backdrop
              // texture exists; GameUi collapses mm_bg* when there is none
              panel { width: 100%; height: 250; overflow: hidden;
                image mm_bg0 { width: 100%; height: 100%; } }
              panel { width: 100%; height: 1; background: #ffffff1c; }
              panel { layout: column; padding: 20 22 22 22;
                text mm_labt0 { class: t_h2; text: "Skyrim"; font-size: 19; letter-spacing: 4;
                  text-transform: uppercase; color: #ffffff; }
                text mm_subt0 { class: t_faint; text: ""; margin: 10 0 0 0; } } }
            panel mm_col1 { width: 328; position: relative; layout: column; cursor: pointer;
              border-color: #ffffff1c; border-width: 1; background: #08090b;
              :hover { border-color: #ffffff8c; background: #101215; }
              panel mm_sel1 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                background: #ffffff; }
              panel { width: 100%; height: 250; overflow: hidden;
                image mm_bg1 { width: 100%; height: 100%; } }
              panel { width: 100%; height: 1; background: #ffffff1c; }
              panel { layout: column; padding: 20 22 22 22;
                text mm_labt1 { class: t_h2; text: "Fallout 4"; font-size: 19; letter-spacing: 4;
                  text-transform: uppercase; }
                text mm_subt1 { class: t_faint; text: ""; margin: 10 0 0 0; } } }
            panel mm_col2 { width: 328; position: relative; layout: column; cursor: pointer;
              border-color: #ffffff1c; border-width: 1; background: #08090b;
              :hover { border-color: #ffffff8c; background: #101215; }
              panel mm_sel2 { position: absolute; left: 0; right: 0; top: 0; height: 2;
                background: #ffffff; }
              panel { width: 100%; height: 250; overflow: hidden;
                image mm_bg2 { width: 100%; height: 100%; } }
              panel { width: 100%; height: 1; background: #ffffff1c; }
              panel { layout: column; padding: 20 22 22 22;
                text mm_labt2 { class: t_h2; text: "Starfield"; font-size: 19; letter-spacing: 4;
                  text-transform: uppercase; }
                text mm_subt2 { class: t_faint; text: ""; margin: 10 0 0 0; } } }
          }

          panel { class: rule; width: 100%; max-width: 1040; margin: 34 0 22 0; }

          panel { layout: row; align: start; justify: space-between; width: 100%;
            max-width: 1040;
            panel { layout: column; gap: 16; flex-grow: 1;
              panel news0 { layout: column; gap: 6;
                text news0_title { class: t_dim; text: ""; }
                text news0_sub { class: t_faint; text: ""; } }
              panel news1 { layout: column; gap: 6;
                text news1_title { class: t_dim; text: ""; }
                text news1_sub { class: t_faint; text: ""; } }
              panel news2 { layout: column; gap: 6;
                text news2_title { class: t_dim; text: ""; }
                text news2_sub { class: t_faint; text: ""; } } }
            panel act_news { cursor: pointer; layout: column; gap: 8; padding: 4 0 0 0;
              :hover { background: #ffffff0a; }
              text { class: t_micro; text: "Changelog"; }
              panel { width: 40; height: 1; background: #ffffff33; } }
          }

          panel mm_screen { position: absolute; left: 56; top: 0; right: 0; bottom: 0;
            background: #000000; layout: column;
            panel { layout: row; align: center; justify: space-between; width: 100%;
              text mm_screen_title { class: t_micro; text: "Multiplayer"; color: #ffffff; }
              panel mm_back { cursor: pointer; padding: 8 14; border-color: #ffffff33;
                border-width: 1;
                :hover { border-color: #ffffff; }
                text { class: t_micro2; text: "Back"; } } }
            panel { class: rule; width: 100%; margin: 16 0 26 0; }


            panel mm_body_mp { layout: column; width: 100%;
              text { class: t_micro; text: "Session"; }
              text mm_mp_universe { class: t_h2; text: "Skyrim"; color: #ffffff; margin: 12 0 0 0; }
              panel { layout: row; gap: 20; margin: 22 0 0 0;
                panel mm_mp_host { width: 328; position: relative; cursor: pointer;
                  layout: column; padding: 24; border-color: #ffffff8c; border-width: 1;
                  background: #101215;
                  :hover { background: #16191d; }
                  panel { position: absolute; left: 0; right: 0; top: 0; height: 2;
                    background: #ffffff; }
                  text { class: t_h2; text: "Host"; font-size: 17; letter-spacing: 4;
                    text-transform: uppercase; color: #ffffff; }
                  text { class: t_faint; text: "Open this world to others";
                    margin: 12 0 0 0; } }
                panel mm_mp_join { width: 328; cursor: pointer; layout: column; padding: 24;
                  border-color: #ffffff1c; border-width: 1; background: #08090b;
                  :hover { border-color: #ffffff8c; }
                  text { class: t_h2; text: "Join"; font-size: 17; letter-spacing: 4;
                    text-transform: uppercase; }
                  text { class: t_faint; text: "Connect to a running session";
                    margin: 12 0 0 0; } } }
              text { class: t_micro2; text: "Listen address"; margin: 26 0 8 0; }
              panel { width: 676; height: 40; layout: column; justify: center;
                text mm_mp_addr { class: t_body; text: "127.0.0.1:29700"; } }
              panel { width: 676; height: 1; background: #ffffff33; }
              text mm_mp_status { class: t_micro2; text: "Offline"; margin: 20 0 0 0; }
            }


            panel mm_body_mods { layout: column; width: 100%;
              text mm_mods_head { class: t_micro; text: "Modules"; }
              panel mm_mods_list { layout: column; width: 100%; max-width: 1040;
                margin: 20 0 0 0;
                panel mm_mod0 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt0 { class: t_dim; text: ""; } }
                panel mm_mod1 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt1 { class: t_dim; text: ""; } }
                panel mm_mod2 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt2 { class: t_dim; text: ""; } }
                panel mm_mod3 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt3 { class: t_dim; text: ""; } }
                panel mm_mod4 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt4 { class: t_dim; text: ""; } }
                panel mm_mod5 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt5 { class: t_dim; text: ""; } }
                panel mm_mod6 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt6 { class: t_dim; text: ""; } }
                panel mm_mod7 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt7 { class: t_dim; text: ""; } }
                panel mm_mod8 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt8 { class: t_dim; text: ""; } }
                panel mm_mod9 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt9 { class: t_dim; text: ""; } }
                panel mm_mod10 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt10 { class: t_dim; text: ""; } }
                panel mm_mod11 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt11 { class: t_dim; text: ""; } }
                panel mm_mod12 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt12 { class: t_dim; text: ""; } }
                panel mm_mod13 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt13 { class: t_dim; text: ""; } }
                panel mm_mod14 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt14 { class: t_dim; text: ""; } }
                panel mm_mod15 { layout: row; align: center; height: 42; gap: 20;
                  text mm_modt15 { class: t_dim; text: ""; } }
              }
              text mm_mods_empty { class: t_faint; text: "Enter a universe to load its modules.";
                margin: 16 0 0 0; }
            }


            panel mm_body_settings { layout: column; width: 100%; max-width: 640;
              text { class: t_micro; text: "Controls"; margin: 0 0 12 0; }
              panel { layout: row; justify: space-between; align: center; height: 44;
                text { class: t_dim; text: "Move"; } text { class: t_body; text: "WASD"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; justify: space-between; align: center; height: 44;
                text { class: t_dim; text: "Look"; } text { class: t_body; text: "Mouse"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; justify: space-between; align: center; height: 44;
                text { class: t_dim; text: "Sprint"; } text { class: t_body; text: "Shift"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; justify: space-between; align: center; height: 44;
                text { class: t_dim; text: "Activate"; } text { class: t_body; text: "E"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; justify: space-between; align: center; height: 44;
                text { class: t_dim; text: "Journal"; } text { class: t_body; text: "J"; } }
              panel { class: rule_dim; width: 100%; }
              panel { layout: row; justify: space-between; align: center; height: 44;
                text { class: t_dim; text: "Pause"; } text { class: t_body; text: "Esc"; } }
            }


            panel mm_body_profile { layout: column; width: 100%;
              panel { layout: row; align: center; gap: 18;
                image gl_profile2 { width: 44; height: 44; }
                panel { layout: column; gap: 6;
                  text mm_pf_name { class: t_h2; text: "local"; color: #ffffff; }
                  text mm_pf_sub { class: t_faint; text: ""; } } }
              panel { class: rule; width: 100%; max-width: 640; margin: 26 0 8 0; }
              panel { layout: row; justify: space-between; align: center; width: 100%;
                max-width: 640; height: 44;
                text { class: t_micro2; text: "Account"; }
                text mm_pf_account { class: t_body; text: "-"; } }
              panel { class: rule_dim; width: 100%; max-width: 640; }
              panel { layout: row; justify: space-between; align: center; width: 100%;
                max-width: 640; height: 44;
                text { class: t_micro2; text: "Machine"; }
                text mm_pf_machine { class: t_body; text: "-"; } }
              panel { class: rule_dim; width: 100%; max-width: 640; }
              panel { layout: row; justify: space-between; align: center; width: 100%;
                max-width: 640; height: 44;
                text { class: t_micro2; text: "Session"; }
                text mm_pf_session { class: t_body; text: "-"; } }
              panel { class: rule_dim; width: 100%; max-width: 640; }
              panel { layout: row; justify: space-between; align: center; width: 100%;
                max-width: 640; height: 44;
                text { class: t_micro2; text: "Build"; }
                text mm_pf_build { class: t_body; text: "-"; } }

              panel mm_pf_char { layout: column; width: 100%; max-width: 640; margin: 26 0 0 0;
                panel { layout: row; align: center; gap: 16; margin: 0 0 10 0;
                  text { class: t_micro2; text: "Health"; width: 74; }
                  ui_meter mm_pf_health { flex-grow: 1; w: 100%; h: 9; } }
                panel { layout: row; align: center; gap: 16; margin: 0 0 10 0;
                  text { class: t_micro2; text: "Magicka"; width: 74; }
                  ui_meter mm_pf_magicka { flex-grow: 1; w: 100%; h: 9; } }
                panel { layout: row; align: center; gap: 16; margin: 0 0 18 0;
                  text { class: t_micro2; text: "Stamina"; width: 74; }
                  ui_meter mm_pf_stamina { flex-grow: 1; w: 100%; h: 9; } }
                panel { layout: row; justify: space-between; align: center; width: 100%;
                  height: 44;
                  text { class: t_micro2; text: "Gold"; }
                  text mm_pf_gold { class: t_body; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; justify: space-between; align: center; width: 100%;
                  height: 44;
                  text { class: t_micro2; text: "Quests"; }
                  text mm_pf_quests { class: t_body; text: "-"; } }
                panel { class: rule_dim; width: 100%; }
                panel { layout: row; justify: space-between; align: center; width: 100%;
                  height: 44;
                  text { class: t_micro2; text: "Location"; }
                  text mm_pf_loc { class: t_body; text: "-"; } }
              }
              text mm_pf_hint { class: t_faint; text: "Enter a universe to load a character.";
                margin: 18 0 0 0; }
            }
          }
        }
      }

      panel { height: 104; layout: row; align: center; gap: 28; width: 100%;
        panel { position: absolute; left: 0; right: 0; top: 0; height: 1; background: #ffffff1c; }
        image gl_profile { width: 26; height: 26; }
        text mm_pname { class: t_h2; text: "Wanderer"; font-size: 16; letter-spacing: 3;
          text-transform: uppercase; color: #ffffff; }
        panel mm_pnet { layout: row; align: center; gap: 10;
          image gl_peers { width: 20; height: 14; }
          text mm_pcount { class: t_micro2; text: "0"; } }
        panel { flex-grow: 1; }
        panel act_globe { cursor: pointer; padding: 14; :hover { background: #ffffff0a; }
          image gl_globe { width: 20; height: 20; } }
        panel act_discord { cursor: pointer; padding: 14; :hover { background: #ffffff0a; }
          image gl_discord { width: 22; height: 17; } }
        panel act_changelog { cursor: pointer; padding: 14; :hover { background: #ffffff0a; }
          image gl_changelog { width: 16; height: 18; } }
        panel act_gear { cursor: pointer; padding: 14; :hover { background: #ffffff0a; }
          image gl_gear { width: 19; height: 19; } }
      }
    }
  }
