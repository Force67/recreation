            panel mm_sp8 { width: 13; height: 2; background: #ffffff3d; }
            panel mm_sp9 { width: 21; height: 2; background: #ffffff3d; }
          }
          text mm_state0 { position: absolute; right: 16; top: 16; font-size: 9;
            letter-spacing: 3; text-transform: uppercase; color: #ffffff8c; text: ""; }
          panel { position: absolute; left: 18; right: 86; bottom: 16; layout: column;
            text mm_kind0 { font-size: 9; letter-spacing: 3; text-transform: uppercase;
              color: #ffffff8c; text: ""; }
            text mm_title0 { font-size: 22; letter-spacing: 4; text-transform: uppercase;
              color: #ffffffcc; margin: 8 0 0 0; text: ""; }
            text mm_detail0 { font-size: 11; letter-spacing: 1; color: #ffffff7a;
              margin: 7 0 0 0; text: ""; } }
          panel mm_play0 { position: absolute; right: 16; bottom: 16; width: 46; height: 46;
            layout: row; justify: center; align: center; cursor: pointer;
            background: #060606; border-color: #ffffff33; border-width: 1;
            panel { width: 10; height: 19; overflow: hidden; position: relative;
              panel mm_tri0 { position: absolute; left: -6; top: 3; width: 13; height: 13;
                background: #ffffffcc; rotation: 45; } } } }
