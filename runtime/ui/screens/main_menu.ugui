// The front-end. PLAY is a paged grid of launchable tiles: one per base game or
// per game mode mounted on one. See docs/ui-mock/untarnished_mainmenu_tiles.html.
//
// A tile is one object: full-bleed key art (mm_art*), a scrim so the meta reads
// over it, the load-order spine (mm_sp*, kMenuSpineTicks ticks per tile) top
// left, state top right, kind/title/detail bottom left, and a square play button
// (mm_play*) bottom right. mm_top* is the 2px rule marking the focused tile.
//
// Eight tiles are declared; GameUi shows the entries of the current page and
// collapses the rest. The utilities that used to be a left nav (Mods, Settings,
// Profile, Quit) sit in the top bar; mm_screen still holds their sub-pages and
// covers the grid while one is open.
//
// Three engine notes. The play glyph is a rotated square inside a clip box
// rather than U+25B6, and the Move hint reads "<>" rather than arrows, because
// the UI font carries neither Geometric Shapes nor Arrows and would draw tofu
// (pause_menu.ugui spells its up/down hint "^v" for the same reason). And a
// panel that has a border must have an OPAQUE background, or ugui fills the
// whole rect with the border colour: hence #060606 on mm_play*, which is what
// the mock's #00000099 composites to over the scrim anyway.

  panel mainmenu {
    position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; background: #000000;
    panel { position: absolute; left: 0; top: 0; right: 0; bottom: 0;
      background: #0e1013; background-end: #000000; gradient-angle: 180; }

    panel { position: absolute; left: 130; right: 130; top: 64; bottom: 0; layout: column;

      panel { layout: row; align: end; justify: space-between; width: 100%;
        // The wordmark is artwork, not set type: ApplyMainMenu rasterizes
        // recreation_wordmark.svg into this box (aspect 8.3:1, so the width
        // follows the height) and binds it like the other emblems.
        image mm_wordmark { width: 266; height: 32; }
        panel { layout: row; align: center; gap: 16; margin: 0 -10 0 0;
          // The guided demo leads the nav and is the one entry at full white:
          // it is not a utility beside Mods and Settings, it is the answer to
          // "what is this", which is the first thing a new player wants. The
          // rule under it marks it as the live element the way the rest of the
          // front-end does. Collapsed by ApplyMainMenu when none is staged.
          panel mm_util_tour { cursor: pointer; padding: 6 10; position: relative;
            :hover { background: #ffffff14; }
            panel { position: absolute; left: 10; right: 10; bottom: 2; height: 1;
              background: #ffffff; }
            text mm_util_tour_t { font-size: 11; letter-spacing: 4;
              text-transform: uppercase; color: #ffffff; text: "Tour"; } }
          // Other people's worlds. The only new destination the multiplayer
          // flow needs: hosting is a property of a launch (the session segment
          // below), joining is a place, because the list lives elsewhere.
          panel mm_util_join { cursor: pointer; padding: 6 10;
            :hover { background: #ffffff0a; }
            text mm_util_join_t { font-size: 11; letter-spacing: 4;
              text-transform: uppercase; color: #9a9a9a; text: "Join"; } }
          panel mm_util_mods { cursor: pointer; padding: 6 10;
            :hover { background: #ffffff0a; }
            text { font-size: 11; letter-spacing: 4; text-transform: uppercase;
              color: #9a9a9a; text: "Mods"; } }
          panel mm_util_settings { cursor: pointer; padding: 6 10;
            :hover { background: #ffffff0a; }
            text { font-size: 11; letter-spacing: 4; text-transform: uppercase;
              color: #9a9a9a; text: "Settings"; } }
          panel mm_util_profile { cursor: pointer; padding: 6 10;
            :hover { background: #ffffff0a; }
            text { font-size: 11; letter-spacing: 4; text-transform: uppercase;
              color: #9a9a9a; text: "Profile"; } }
          panel mm_util_quit { cursor: pointer; padding: 6 10;
            :hover { background: #ffffff0a; }
            text { font-size: 11; letter-spacing: 4; text-transform: uppercase;
              color: #5e5e5e; text: "Quit"; } }
        }
      }
      panel { width: 100%; height: 1; margin: 22 0 0 0;
        background: #ffffff66; background-end: #ffffff00; gradient-angle: 90; }

      // The grid's own header. It sits above mm_screen's top edge, so it has to
      // be collapsed while a sub-screen is open or the segment and the pager
      // hang over a screen they have nothing to do with.
      panel mm_playrow { layout: row; align: center; justify: space-between; width: 100%;
        margin: 28 0 0 0;
        // Who is coming, stated on the surface it governs: the segment applies
        // to every launch below it, the grid and the rail both. Solo plays
        // alone, Friends opens the session to an invite, Public lists it.
        // ApplyMainMenu lights one rule and dims the other two labels.
        panel { layout: row; align: center; gap: 26;
          text { class: t_micro; text: "Play"; }
          panel { width: 1; height: 14; background: #ffffff26; }
          panel mm_sess0 { cursor: pointer; padding: 0 0 8 0; position: relative;
            text mm_sess0_t { font-size: 11; letter-spacing: 4; text-transform: uppercase;
              color: #5e5e5e; text: "Solo"; }
            panel mm_sess0_r { position: absolute; left: 0; right: 0; bottom: 0; height: 2;
              background: #ffffff; } }
          panel mm_sess1 { cursor: pointer; padding: 0 0 8 0; position: relative;
            text mm_sess1_t { font-size: 11; letter-spacing: 4; text-transform: uppercase;
              color: #5e5e5e; text: "Friends"; }
            panel mm_sess1_r { position: absolute; left: 0; right: 0; bottom: 0; height: 2;
              background: #ffffff; } }
          panel mm_sess2 { cursor: pointer; padding: 0 0 8 0; position: relative;
            text mm_sess2_t { font-size: 11; letter-spacing: 4; text-transform: uppercase;
              color: #5e5e5e; text: "Public"; }
            panel mm_sess2_r { position: absolute; left: 0; right: 0; bottom: 0; height: 2;
              background: #ffffff; } } }
        panel { layout: row; align: center; gap: 16;
          text mm_pagelbl { class: t_micro; text: "Page 1 / 1"; }
          panel { layout: row; gap: 5;
            panel mm_pip0 { width: 26; height: 3; background: #ffffff26; cursor: pointer; }
            panel mm_pip1 { width: 26; height: 3; background: #ffffff26; cursor: pointer; }
            panel mm_pip2 { width: 26; height: 3; background: #ffffff26; cursor: pointer; }
            panel mm_pip3 { width: 26; height: 3; background: #ffffff26; cursor: pointer; }
            panel mm_pip4 { width: 26; height: 3; background: #ffffff26; cursor: pointer; }
            panel mm_pip5 { width: 26; height: 3; background: #ffffff26; cursor: pointer; }
            panel mm_pip6 { width: 26; height: 3; background: #ffffff26; cursor: pointer; }
            panel mm_pip7 { width: 26; height: 3; background: #ffffff26; cursor: pointer; }
          } } }

      // No fixed height: the grid wraps on width, so letting it hug its content
      // keeps a half-full page from reserving a second row of dead space and
      // pushing the rail to the floor.
      panel mm_grid { layout: row; flex-wrap: wrap; gap: 18; width: 100%;
        align-content: start; margin: 20 0 0 0;
        panel mm_tile0 { width: 400; height: 286; position: relative; overflow: hidden;
          cursor: pointer; border-color: #ffffff1c; border-width: 1; background: #06070a;
          :hover { border-color: #ffffff5e; }
          image mm_art0 { position: absolute; left: 0; top: 0; width: 100%; height: 100%;
            opacity: 0.62; }
          panel { position: absolute; left: 0; right: 0; bottom: 0; height: 177;
            background: #00000000; background-end: #000000f2; gradient-angle: 180; }
          panel mm_top0 { position: absolute; left: 0; right: 0; top: 0; height: 2;
            background: #ffffff; }
          panel { position: absolute; left: 18; top: 20; layout: column; gap: 3;
            panel mm_sp0 { width: 22; height: 2; background: #ffffff3d; }
            panel mm_sp1 { width: 14; height: 2; background: #ffffff3d; }
            panel mm_sp2 { width: 26; height: 2; background: #ffffff3d; }
            panel mm_sp3 { width: 11; height: 2; background: #ffffff3d; }
            panel mm_sp4 { width: 19; height: 2; background: #ffffff3d; }
            panel mm_sp5 { width: 24; height: 2; background: #ffffff3d; }
            panel mm_sp6 { width: 9; height: 2; background: #ffffff3d; }
            panel mm_sp7 { width: 17; height: 2; background: #ffffff3d; }
            panel mm_sp8 { width: 13; height: 2; background: #ffffff3d; }
            panel mm_sp9 { width: 21; height: 2; background: #ffffff3d; }
          }
          text mm_state0 { position: absolute; right: 16; top: 16; font-size: 9;
            letter-spacing: 3; text-transform: uppercase; color: #ffffff8c; text: ""; }
          panel { position: absolute; left: 18; right: 86; bottom: 16; layout: column;
            text mm_kind0 { font-size: 9; letter-spacing: 3; text-transform: uppercase;
              color: #ffffff8c; text: ""; }
            text mm_title0 { font-size: 22; letter-spacing: 4; text-transform: uppercase;
              color: #ffffffcc; margin: 8 0 0 0; text: ""; }
            text mm_detail0 { font-size: 11; letter-spacing: 1; color: #ffffff7a;
              margin: 7 0 0 0; text: ""; } }
          panel mm_play0 { position: absolute; right: 16; bottom: 16; width: 46; height: 46;
            layout: row; justify: center; align: center; cursor: pointer;
            background: #060606; border-color: #ffffff33; border-width: 1;
            panel { width: 10; height: 19; overflow: hidden; position: relative;
              panel mm_tri0 { position: absolute; left: -6; top: 3; width: 13; height: 13;
                background: #ffffffcc; rotation: 45; } } } }
        panel mm_tile1 { width: 400; height: 286; position: relative; overflow: hidden;
          cursor: pointer; border-color: #ffffff1c; border-width: 1; background: #06070a;
