      panel { flex-grow: 1; }

      panel { height: 88; layout: row; align: center; gap: 26; width: 100%;
        position: relative;
        panel { position: absolute; left: 0; right: 0; top: 0; height: 1; background: #ffffff1c; }
        text mm_pname { font-size: 16; letter-spacing: 3; text-transform: uppercase;
          color: #ffffff; text: "Wanderer"; }
        text mm_psys { font-size: 11; letter-spacing: 3; text-transform: uppercase;
          color: #5e5e5e; text: ""; }
        panel mm_pnet { layout: row; align: center; gap: 10;
          image gl_peers { width: 20; height: 14; }
          text mm_pcount { class: t_micro2; text: "0"; } }
        panel { flex-grow: 1; }
        panel { layout: row; align: center; gap: 30;
          panel { layout: row; align: center; gap: 11;
            panel { width: 26; height: 26; layout: row; justify: center; align: center;
              border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "<>"; } }
            text { font-size: 11; letter-spacing: 3; text-transform: uppercase;
              color: #5e5e5e; text: "Move"; } }
          panel { layout: row; align: center; gap: 11;
            panel { width: 26; height: 26; layout: row; justify: center; align: center;
              border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "Q"; } }
            panel { width: 26; height: 26; layout: row; justify: center; align: center;
              border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "E"; } }
            text { font-size: 11; letter-spacing: 3; text-transform: uppercase;
              color: #5e5e5e; text: "Page"; } }
          panel { layout: row; align: center; gap: 11;
            panel { height: 26; padding: 0 7; layout: row; justify: center; align: center;
              border-color: #ffffff2e; border-width: 1;
              text { font-size: 11; color: #ffffff; text: "Enter"; } }
            text { font-size: 11; letter-spacing: 3; text-transform: uppercase;
              color: #5e5e5e; text: "Play"; } } }
        text mm_build { font-size: 11; letter-spacing: 3; text-transform: uppercase;
          color: #5e5e5e; margin: 0 0 0 30; text: ""; }
      }

      panel mm_screen { position: absolute; left: 0; top: 92; right: 0; bottom: 88;
        background: #000000; layout: column;
        panel { layout: row; align: center; justify: space-between; width: 100%;
          text mm_screen_title { class: t_micro; text: "Multiplayer"; color: #ffffff; }
          panel mm_back { cursor: pointer; padding: 8 14; border-color: #ffffff33;
            border-width: 1;
            :hover { border-color: #ffffff; }
            text { class: t_micro2; text: "Back"; } } }
        panel { class: rule; width: 100%; margin: 16 0 26 0; }


        panel mm_body_mp { layout: column; width: 100%;
          text { class: t_micro; text: "Session"; }
          text mm_mp_universe { class: t_h2; text: "Skyrim"; color: #ffffff; margin: 12 0 0 0; }
          panel { layout: row; gap: 20; margin: 22 0 0 0;
            panel mm_mp_host { width: 328; position: relative; cursor: pointer;
              layout: column; padding: 24; border-color: #ffffff8c; border-width: 1;
              background: #101215;
              :hover { background: #16191d; }
              panel { position: absolute; left: 0; right: 0; top: 0; height: 2;
                background: #ffffff; }
              text { class: t_h2; text: "Host"; font-size: 17; letter-spacing: 4;
                text-transform: uppercase; color: #ffffff; }
              text { class: t_faint; text: "Open this world to others";
                margin: 12 0 0 0; } }
            panel mm_mp_join { width: 328; cursor: pointer; layout: column; padding: 24;
              border-color: #ffffff1c; border-width: 1; background: #08090b;
              :hover { border-color: #ffffff8c; }
              text { class: t_h2; text: "Join"; font-size: 17; letter-spacing: 4;
                text-transform: uppercase; }
              text { class: t_faint; text: "Connect to a running session";
                margin: 12 0 0 0; } } }
          text { class: t_micro2; text: "Listen address"; margin: 26 0 8 0; }
          panel { width: 676; height: 40; layout: column; justify: center;
            text mm_mp_addr { class: t_body; text: "127.0.0.1:29700"; } }
          panel { width: 676; height: 1; background: #ffffff33; }
          text mm_mp_status { class: t_micro2; text: "Offline"; margin: 20 0 0 0; }
        }


        panel mm_body_mods { layout: column; width: 100%;
          text mm_mods_head { class: t_micro; text: "Modules"; }
          panel mm_mods_list { layout: column; width: 100%; max-width: 1040;
            margin: 20 0 0 0;
            panel mm_mod0 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt0 { class: t_dim; text: ""; } }
            panel mm_mod1 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt1 { class: t_dim; text: ""; } }
            panel mm_mod2 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt2 { class: t_dim; text: ""; } }
            panel mm_mod3 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt3 { class: t_dim; text: ""; } }
            panel mm_mod4 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt4 { class: t_dim; text: ""; } }
            panel mm_mod5 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt5 { class: t_dim; text: ""; } }
            panel mm_mod6 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt6 { class: t_dim; text: ""; } }
            panel mm_mod7 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt7 { class: t_dim; text: ""; } }
            panel mm_mod8 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt8 { class: t_dim; text: ""; } }
            panel mm_mod9 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt9 { class: t_dim; text: ""; } }
            panel mm_mod10 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt10 { class: t_dim; text: ""; } }
            panel mm_mod11 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt11 { class: t_dim; text: ""; } }
            panel mm_mod12 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt12 { class: t_dim; text: ""; } }
            panel mm_mod13 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt13 { class: t_dim; text: ""; } }
            panel mm_mod14 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt14 { class: t_dim; text: ""; } }
            panel mm_mod15 { layout: row; align: center; height: 42; gap: 20;
              text mm_modt15 { class: t_dim; text: ""; } }
          }
          text mm_mods_empty { class: t_faint; text: "Enter a universe to load its modules.";
            margin: 16 0 0 0; }
        }


        panel mm_body_settings { layout: column; width: 100%; max-width: 640;
          text { class: t_micro; text: "Controls"; margin: 0 0 12 0; }
          panel { layout: row; justify: space-between; align: center; height: 44;
            text { class: t_dim; text: "Move"; } text { class: t_body; text: "WASD"; } }
          panel { class: rule_dim; width: 100%; }
          panel { layout: row; justify: space-between; align: center; height: 44;
            text { class: t_dim; text: "Look"; } text { class: t_body; text: "Mouse"; } }
          panel { class: rule_dim; width: 100%; }
          panel { layout: row; justify: space-between; align: center; height: 44;
            text { class: t_dim; text: "Sprint"; } text { class: t_body; text: "Shift"; } }
          panel { class: rule_dim; width: 100%; }
          panel { layout: row; justify: space-between; align: center; height: 44;
            text { class: t_dim; text: "Activate"; } text { class: t_body; text: "E"; } }
          panel { class: rule_dim; width: 100%; }
          panel { layout: row; justify: space-between; align: center; height: 44;
            text { class: t_dim; text: "Journal"; } text { class: t_body; text: "J"; } }
          panel { class: rule_dim; width: 100%; }
          panel { layout: row; justify: space-between; align: center; height: 44;
            text { class: t_dim; text: "Pause"; } text { class: t_body; text: "Esc"; } }
        }


        panel mm_body_profile { layout: column; width: 100%;
          panel { layout: row; align: center; gap: 18;
            image gl_profile2 { width: 44; height: 44; }
            panel { layout: column; gap: 6;
              text mm_pf_name { class: t_h2; text: "local"; color: #ffffff; }
              text mm_pf_sub { class: t_faint; text: ""; } } }
          panel { class: rule; width: 100%; max-width: 640; margin: 26 0 8 0; }
          panel { layout: row; justify: space-between; align: center; width: 100%;
            max-width: 640; height: 44;
            text { class: t_micro2; text: "Account"; }
            text mm_pf_account { class: t_body; text: "-"; } }
          panel { class: rule_dim; width: 100%; max-width: 640; }
          panel { layout: row; justify: space-between; align: center; width: 100%;
            max-width: 640; height: 44;
            text { class: t_micro2; text: "Machine"; }
            text mm_pf_machine { class: t_body; text: "-"; } }
          panel { class: rule_dim; width: 100%; max-width: 640; }
          panel { layout: row; justify: space-between; align: center; width: 100%;
            max-width: 640; height: 44;
            text { class: t_micro2; text: "Session"; }
            text mm_pf_session { class: t_body; text: "-"; } }
          panel { class: rule_dim; width: 100%; max-width: 640; }
          panel { layout: row; justify: space-between; align: center; width: 100%;
            max-width: 640; height: 44;
            text { class: t_micro2; text: "Build"; }
            text mm_pf_build { class: t_body; text: "-"; } }

          panel mm_pf_char { layout: column; width: 100%; max-width: 640; margin: 26 0 0 0;
            panel { layout: row; align: center; gap: 16; margin: 0 0 10 0;
              text { class: t_micro2; text: "Health"; width: 74; }
              ui_meter mm_pf_health { flex-grow: 1; w: 100%; h: 9; } }
            panel { layout: row; align: center; gap: 16; margin: 0 0 10 0;
              text { class: t_micro2; text: "Magicka"; width: 74; }
              ui_meter mm_pf_magicka { flex-grow: 1; w: 100%; h: 9; } }
            panel { layout: row; align: center; gap: 16; margin: 0 0 18 0;
              text { class: t_micro2; text: "Stamina"; width: 74; }
              ui_meter mm_pf_stamina { flex-grow: 1; w: 100%; h: 9; } }
            panel { layout: row; justify: space-between; align: center; width: 100%;
              height: 44;
              text { class: t_micro2; text: "Gold"; }
              text mm_pf_gold { class: t_body; text: "-"; } }
            panel { class: rule_dim; width: 100%; }
            panel { layout: row; justify: space-between; align: center; width: 100%;
              height: 44;
              text { class: t_micro2; text: "Quests"; }
              text mm_pf_quests { class: t_body; text: "-"; } }
            panel { class: rule_dim; width: 100%; }
            panel { layout: row; justify: space-between; align: center; width: 100%;
              height: 44;
              text { class: t_micro2; text: "Location"; }
              text mm_pf_loc { class: t_body; text: "-"; } }
          }
          text mm_pf_hint { class: t_faint; text: "Enter a universe to load a character.";
            margin: 18 0 0 0; }
        }
      }
    }
  }
