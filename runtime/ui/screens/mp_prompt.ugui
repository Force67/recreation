// Multiplayer interaction prompts. Fed from SetPrompts; distinct from
// activate_box so a module's prompts and the world's own prompt can coexist.
// GameUi collapses the box and each row, so no per-row wrapper is needed.

  panel mp_prompt_box {
    position: absolute; left: 0; bottom: 240; width: 100vw;
    layout: column; align: center; gap: 8; visibility: collapsed;
    text mp_prompt0 { class: t_body; text: ""; letter-spacing: 2;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    text mp_prompt1 { class: t_body; text: ""; letter-spacing: 2;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    text mp_prompt2 { class: t_body; text: ""; letter-spacing: 2;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
  }
