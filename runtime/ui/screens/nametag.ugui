// Floating world-space player nametags, placed at each player's screen
// projection by SetNametags. No plate or border: a slab per player would litter
// the scene at this size.

  panel nametags { position: absolute; left: 0; top: 0; width: 0; height: 0;
    panel nametag0  { position: absolute; left: 0; top: 0; visibility: collapsed;
      text nametag0_txt  { class: t_key; text: ""; font-size: 11;
        text-shadow-color: #000000e0; text-shadow-x: 1; text-shadow-y: 1; } }
    panel nametag1  { position: absolute; left: 0; top: 0; visibility: collapsed;
      text nametag1_txt  { class: t_key; text: ""; font-size: 11;
        text-shadow-color: #000000e0; text-shadow-x: 1; text-shadow-y: 1; } }
