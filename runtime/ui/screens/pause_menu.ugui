// The pause menu. Settings is a sub-page, not a separate screen: menu_buttons
// stays put and only the pane beside it swaps (menu_detail <-> menu_settings).
// ApplyMenuVisibility drives that and moves the marker rail to whichever entry
// owns the visible pane.
//
// Clicks route by widget name through GameUi's on_click router, which fires for
// panels as well as buttons; the rows are buttons for focus traversal.

  panel menu {
    position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
    background: #000000e0; backdrop-blur: 26;

    panel menu_card { position: absolute; left: 130; right: 130; top: 76; bottom: 0;
      layout: column;

      panel { layout: row; align: end; justify: space-between; width: 100%;
        text menu_title { class: t_mast; text: "Paused"; }
        panel { layout: column; align: end; gap: 8;
          text menu_sub { class: t_micro2; text: "Recreation"; color: #9a9a9a; }
          text menu_where { class: t_micro2; text: ""; }
        }
      }
      panel menu_rule { width: 100%; height: 1; margin: 26 0 0 0;
        background: #ffffff66; background-end: #ffffff00; gradient-angle: 90; }

      panel { flex-grow: 1; layout: row; align: stretch; width: 100%; padding: 44 0 0 0;

        panel menu_buttons { width: 520; layout: column;
          button btn_resume { position: relative; layout: row; align: center; height: 74;
            padding: 0 30 0 26; cursor: pointer; tab-index: 0;
            :hover { background: #ffffff14; } :focused { background: #ffffff1f; }
            panel btn_resume_mk { position: absolute; left: 0; top: 18; bottom: 18;
              width: 3; background: #ffffff; }
            text { class: t_h2; text: "Resume"; flex-grow: 1; color: #ffffff; }
            text { class: t_micro2; text: "Esc"; }
          }
          button btn_settings { position: relative; layout: row; align: center; height: 74;
            padding: 0 30 0 26; cursor: pointer; tab-index: 1;
            :hover { background: #ffffff14; } :focused { background: #ffffff1f; }
            panel btn_settings_mk { position: absolute; left: 0; top: 18; bottom: 18;
              width: 3; background: #ffffff; }
            text { class: t_h2; text: "Settings"; flex-grow: 1; }
            text { class: t_micro2; text: "Controls"; }
          }
          button btn_quit { position: relative; layout: row; align: center; height: 74;
            padding: 0 30 0 26; cursor: pointer; tab-index: 2;
            :hover { background: #ffffff14; } :focused { background: #ffffff1f; }
            text { class: t_h2; text: "Quit"; flex-grow: 1; }
            text { class: t_micro2; text: "To desktop"; }
          }
        }

        panel { width: 1; background: #ffffff1c; }

        panel { flex-grow: 1; layout: column; padding: 0 0 0 56;

          // root pane
          panel menu_detail { layout: column; width: 100%;
            text { class: t_micro; text: "Character"; }
            text menu_pname { class: t_h1; text: "Wanderer"; font-size: 29; letter-spacing: 3;
              margin: 20 0 0 0; }
            panel { class: rule; width: 100%; max-width: 560; margin: 26 0 8 0; }
            panel { layout: row; align: center; justify: space-between; width: 100%;
              max-width: 440; padding: 12 0;
              text { class: t_micro2; text: "Level"; }
              text menu_level { class: t_body; text: "-"; } }
            panel { class: rule_dim; width: 100%; max-width: 440; }
            panel { layout: row; align: center; justify: space-between; width: 100%;
              max-width: 440; padding: 12 0;
              text { class: t_micro2; text: "Quests"; }
              text menu_quests { class: t_body; text: "-"; } }
            panel { class: rule_dim; width: 100%; max-width: 440; }
            panel { layout: row; align: center; justify: space-between; width: 100%;
              max-width: 440; padding: 12 0;
              text { class: t_micro2; text: "Gold"; }
              text menu_gold { class: t_body; text: "-"; } }
            panel { class: rule_dim; width: 100%; max-width: 440; }
            panel { layout: row; align: center; justify: space-between; width: 100%;
              max-width: 440; padding: 12 0;
              text { class: t_micro2; text: "Location"; }
              text menu_loc { class: t_body; text: "-"; } }

            panel { layout: column; gap: 10; width: 100%; max-width: 440; margin: 26 0 0 0;
              panel { layout: row; align: center; gap: 16;
                text { class: t_micro2; text: "Health"; width: 74; }
                ui_meter menu_hp { flex-grow: 1; w: 100%; h: 9; } }
              panel { layout: row; align: center; gap: 16;
                text { class: t_micro2; text: "Magicka"; width: 74; }
                ui_meter menu_mp { flex-grow: 1; w: 100%; h: 9; } }
              panel { layout: row; align: center; gap: 16;
                text { class: t_micro2; text: "Stamina"; width: 74; }
                ui_meter menu_sp { flex-grow: 1; w: 100%; h: 9; } }
            }
          }

          // settings pane
          panel menu_settings { layout: column; width: 100%;
            // A single heading, not a tab bar. Controls is the only settings
            // category the engine has; Display and Audio tabs would be dead
            // affordances until there is something behind them.
            panel { position: relative; padding: 0 0 16 0;
              text settings_head { class: t_micro; text: "Controls"; color: #ffffff; }
              panel { position: absolute; left: 0; right: 0; bottom: 0; height: 2;
                background: #ffffff; } }
            panel { class: rule; width: 100%; }

            text { class: t_micro; text: "Bindings"; margin: 30 0 6 0; }
            scroll rebind_list { width: 100%; max-width: 640; height: 330; layout: column;
              button rebind_0 { layout: row; justify: space-between; align: center; width: 100%;
                height: 46; cursor: pointer; tab-index: 1;
                :hover { background: #ffffff0a; } :focused { background: #ffffff14; }
                text rebind_0_lbl { class: t_dim; text: "-"; font-size: 15; }
                text rebind_0_key { class: t_body; text: ""; font-size: 13; letter-spacing: 2; } }
              button rebind_1 { layout: row; justify: space-between; align: center; width: 100%;
                height: 46; cursor: pointer; tab-index: 2;
                :hover { background: #ffffff0a; } :focused { background: #ffffff14; }
                text rebind_1_lbl { class: t_dim; text: "-"; font-size: 15; }
                text rebind_1_key { class: t_body; text: ""; font-size: 13; letter-spacing: 2; } }
              button rebind_2 { layout: row; justify: space-between; align: center; width: 100%;
                height: 46; cursor: pointer; tab-index: 3;
                :hover { background: #ffffff0a; } :focused { background: #ffffff14; }
                text rebind_2_lbl { class: t_dim; text: "-"; font-size: 15; }
                text rebind_2_key { class: t_body; text: ""; font-size: 13; letter-spacing: 2; } }
              button rebind_3 { layout: row; justify: space-between; align: center; width: 100%;
                height: 46; cursor: pointer; tab-index: 4;
                :hover { background: #ffffff0a; } :focused { background: #ffffff14; }
                text rebind_3_lbl { class: t_dim; text: "-"; font-size: 15; }
                text rebind_3_key { class: t_body; text: ""; font-size: 13; letter-spacing: 2; } }
              button rebind_4 { layout: row; justify: space-between; align: center; width: 100%;
                height: 46; cursor: pointer; tab-index: 5;
                :hover { background: #ffffff0a; } :focused { background: #ffffff14; }
                text rebind_4_lbl { class: t_dim; text: "-"; font-size: 15; }
                text rebind_4_key { class: t_body; text: ""; font-size: 13; letter-spacing: 2; } }
              button rebind_5 { layout: row; justify: space-between; align: center; width: 100%;
                height: 46; cursor: pointer; tab-index: 6;
                :hover { background: #ffffff0a; } :focused { background: #ffffff14; }
                text rebind_5_lbl { class: t_dim; text: "-"; font-size: 15; }
                text rebind_5_key { class: t_body; text: ""; font-size: 13; letter-spacing: 2; } }
              button rebind_6 { layout: row; justify: space-between; align: center; width: 100%;
                height: 46; cursor: pointer; tab-index: 7;
                :hover { background: #ffffff0a; } :focused { background: #ffffff14; }
                text rebind_6_lbl { class: t_dim; text: "-"; font-size: 15; }
                text rebind_6_key { class: t_body; text: ""; font-size: 13; letter-spacing: 2; } }
              button rebind_7 { layout: row; justify: space-between; align: center; width: 100%;
                height: 46; cursor: pointer; tab-index: 8;
                :hover { background: #ffffff0a; } :focused { background: #ffffff14; }
                text rebind_7_lbl { class: t_dim; text: "-"; font-size: 15; }
                text rebind_7_key { class: t_body; text: ""; font-size: 13; letter-spacing: 2; } }
            }
            panel ctl_rule { class: rule_dim; width: 100%; max-width: 640; margin: 4 0 0 0; }

            text { class: t_micro; text: "Look"; margin: 26 0 6 0; }
            panel sens_kbm_row { layout: row; justify: space-between; align: center;
              width: 100%; max-width: 640; height: 52;
              text { class: t_dim; text: "Mouse sensitivity"; font-size: 15; }
              panel { layout: row; align: center; gap: 2;
                button btn_skbm_dec { width: 30; height: 30; layout: column; justify: center;
                  align: center; cursor: pointer; border-color: #ffffff33; border-width: 1;
                  :hover { border-color: #ffffff; }
                  text { text: "-"; font-size: 15; color: #9a9a9a; } }
                text sens_kbm_val { class: t_body; text: "0.0025"; width: 78; text-align: center; }
                button btn_skbm_inc { width: 30; height: 30; layout: column; justify: center;
                  align: center; cursor: pointer; border-color: #ffffff33; border-width: 1;
                  :hover { border-color: #ffffff; }
                  text { text: "+"; font-size: 15; color: #9a9a9a; } } } }
            panel { class: rule_dim; width: 100%; max-width: 640; }
            panel sens_pad_row { layout: row; justify: space-between; align: center;
              width: 100%; max-width: 640; height: 52;
              text { class: t_dim; text: "Gamepad sensitivity"; font-size: 15; }
              panel { layout: row; align: center; gap: 2;
                button btn_spad_dec { width: 30; height: 30; layout: column; justify: center;
                  align: center; cursor: pointer; border-color: #ffffff33; border-width: 1;
                  :hover { border-color: #ffffff; }
                  text { text: "-"; font-size: 15; color: #9a9a9a; } }
                text sens_pad_val { class: t_body; text: "2.60"; width: 78; text-align: center; }
                button btn_spad_inc { width: 30; height: 30; layout: column; justify: center;
                  align: center; cursor: pointer; border-color: #ffffff33; border-width: 1;
                  :hover { border-color: #ffffff; }
                  text { text: "+"; font-size: 15; color: #9a9a9a; } } } }
            panel settings_rule { class: rule_dim; width: 100%; max-width: 640; }

            panel ctl_actions { layout: row; gap: 12; margin: 30 0 0 0;
              button btn_settings_back { height: 42; padding: 0 28; layout: column;
                justify: center; align: center; cursor: pointer; background: #ffffff;
                tab-index: 0;
                :hover { background: #d2d2d2; }
                text { class: t_micro; text: "Back"; color: #000000; } }
              button btn_invert { height: 42; padding: 0 28; layout: column; justify: center;
                align: center; cursor: pointer; border-color: #ffffff33; border-width: 1;
                :hover { border-color: #ffffff; }
                text { class: t_micro; text: "Invert Y: Off"; } }
              button btn_rumble { height: 42; padding: 0 28; layout: column; justify: center;
                align: center; cursor: pointer; border-color: #ffffff33; border-width: 1;
                :hover { border-color: #ffffff; }
                text { class: t_micro; text: "Test rumble"; } }
              button btn_reset { height: 42; padding: 0 28; layout: column; justify: center;
                align: center; cursor: pointer; border-color: #ffffff33; border-width: 1;
                :hover { border-color: #ffffff; }
                text { class: t_micro; text: "Reset"; } }
            }
          }
        }
      }

      panel { height: 96; layout: row; align: center; gap: 44; width: 100%;
        panel { position: absolute; left: 0; right: 0; top: 0; height: 1; background: #ffffff1c; }
        ui_hint { k: "^v"; a: "Select"; }
        ui_hint { k: "E"; a: "Confirm"; }
        ui_hint { k: "Esc"; a: "Back"; }
        panel { flex-grow: 1; }
        text menu_build { class: t_micro2; text: "Recreation"; }
      }
    }
  }
