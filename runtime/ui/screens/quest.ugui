// The notification rail, right-aligned. No plate: these are transient, so
// legibility comes from the text shadow rather than a permanent slab.
//
// quest_rule is an accent site. The objective rows stay bare text widgets
// rather than gaining bullets, because GameUi collapses each row individually
// and a wrapper would leave its bullet stranded once the text was hidden.

  panel questtracker {
    position: absolute; right: 52; top: 120; width: 380; layout: column; align: end;
    text quest_title { class: t_key; text: ""; text-align: right;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    panel quest_rule { width: 100%; height: 1; background: #ffffff77; margin: 10 0 16 0; }
    text quest_obj0 { class: t_body; text: ""; font-size: 19; text-align: right; margin: 0 0 9 0;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    text quest_obj1 { class: t_dim; text: ""; text-align: right; margin: 0 0 9 0;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    text quest_obj2 { class: t_dim; text: ""; text-align: right; margin: 0 0 9 0;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    text quest_obj3 { class: t_dim; text: ""; text-align: right; margin: 0 0 9 0;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    text quest_obj4 { class: t_out; text: ""; font-size: 13; text-align: right; margin: 0 0 9 0;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    text quest_obj5 { class: t_out; text: ""; font-size: 13; text-align: right; margin: 0 0 9 0;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
  }

  panel quest_marker_box {
    position: absolute; top: 78; left: 0; width: 100vw; layout: column; align: center;
    text quest_marker_text { class: t_micro2; text: "";
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
  }

  // same shape as the location reveal in location.ugui
  panel quest_toast_box {
    position: absolute; top: 150; left: 0; width: 100vw; layout: column; align: center;
    panel { width: 460; layout: column; align: center;
      panel { width: 100%; height: 1; background: #ffffff55; }
      text quest_toast { class: t_key; text: ""; font-size: 13; margin: 14 0 14 0;
        text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
      panel { width: 100%; height: 1; background: #ffffff55; }
    }
  }

  // acc_prompt_key carries the accent on its border.
  panel activate_box {
    position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
    layout: column; justify: center; align: center;
    panel { layout: row; align: center; gap: 14; margin: 120 0 0 0;
      panel acc_prompt_key { width: 28; height: 28; layout: column; justify: center; align: center;
        border-color: #ffffff77; border-width: 1;
        text { text: "E"; font-size: 12; color: #ffffff; letter-spacing: 1; } }
      text activate_prompt { class: t_body; text: ""; font-size: 16; letter-spacing: 2;
        text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    }
  }
