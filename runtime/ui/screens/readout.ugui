// Bottom-right corner: currency, then technical detail at tertiary grey.

  panel readout {
    position: absolute; right: 52; bottom: 48; layout: column; align: end; gap: 12;
    panel { layout: row; align: baseline; gap: 12;
      text { class: t_micro2; text: "Gold"; letter-spacing: 4; }
      text hud_gold { class: t_num; text: "0";
        text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    }
    text hud_fps { class: t_faint; text: "-- fps"; text-align: right;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    text hud_coords { class: t_faint; text: "X -- Y -- Z --"; text-align: right;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
    text hud_heading { class: t_faint; text: "--"; text-align: right;
      text-shadow-color: #000000cc; text-shadow-x: 1; text-shadow-y: 1; }
  }
