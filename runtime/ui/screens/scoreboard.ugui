// Multiplayer scoreboard (hold Tab). Rows arrive from SetScoreboard as
// pre-formatted strings. Centred by a full-width wrapper rather than a pixel
// offset so it stays centred at any resolution.

  panel scoreboard_box {
    position: absolute; left: 0; top: 150; width: 100vw;
    layout: column; align: center; visibility: collapsed;
    panel { class: plate_w; layout: column; align: stretch; width: 860; padding: 30 34 34 34;
      panel { layout: row; align: end; justify: space-between; width: 100%;
        text scoreboard_title { class: t_h1; text: ""; font-size: 26; letter-spacing: 6; }
        text { class: t_micro2; text: "Tab"; } }
      panel { class: rule; width: 100%; margin: 20 0 0 0; }
      text scoreboard_header { class: t_micro; text: ""; margin: 18 0 12 0; }
      panel scoreboard_rule { class: rule_dim; width: 100%; margin: 0 0 14 0; }
      text scoreboard_row0  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row1  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row2  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row3  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row4  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row5  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row6  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row7  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row8  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row9  { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row10 { class: t_body; text: ""; margin: 0 0 8 0; }
      text scoreboard_row11 { class: t_body; text: ""; margin: 0 0 8 0; }
    }
  }
