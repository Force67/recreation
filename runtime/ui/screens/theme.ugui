// Shared style classes and components for every screen. Design rationale and
// the mocks these implement live in docs/ui-mock/.
//
// PRELUDE: game_ui.cc concatenates this ahead of `panel root`, because `class`
// and `component` are top-level declarations while the screens are nested
// inside root. It contributes no widgets.
//
// Two engine constraints the whole system is built around:
//   - `left: 30%` resolves to 0. Positional work is pixels or flexbox.
//   - `:hover`/`:focused` style the widget they sit on, not its children, so a
//     control whose label changes on hover carries that text on the widget.
//   - `visibility: collapsed` in markup is ignored; only SetVisible works.

// black #000000  plate #0d0d0d  fg #ffffff  dim #9a9a9a  dim2 #5e5e5e
// line #ffffff1c  line2 #ffffff33  line3 #ffffff10  accent #ffffff (per domain)

// ===================== type =====================
class t_mast   { font-size: 44; color: #ffffff; letter-spacing: 13; text-transform: uppercase; }
class t_h1     { font-size: 30; color: #ffffff; letter-spacing: 10; text-transform: uppercase; }
class t_h2     { font-size: 23; color: #9a9a9a; letter-spacing: 4;  }
class t_num    { font-size: 26; color: #ffffff; letter-spacing: 2;  }
class t_micro  { font-size: 11; color: #5e5e5e; letter-spacing: 5; text-transform: uppercase; }
class t_micro2 { font-size: 10; color: #5e5e5e; letter-spacing: 3; text-transform: uppercase; }
class t_key    { font-size: 11; color: #ffffff; letter-spacing: 5; text-transform: uppercase; }
class t_body   { font-size: 15; color: #ffffff; letter-spacing: 1; }
class t_dim    { font-size: 13; color: #9a9a9a; letter-spacing: 1; }
class t_faint  { font-size: 11; color: #5e5e5e; letter-spacing: 2; }
class t_out    { color: #5e5e5e; }

// ===================== surface =====================
class plate_w  { background: #000000e0; }   // over live gameplay
class rule     { height: 1; background: #ffffff1c; }
class rule_dim { height: 1; background: #ffffff10; }

// ===================== components =====================

// A named instance takes the instance name for its ROOT and prefixes its
// children, so `ui_meter bar_health {}` yields bar_health / bar_health_track /
// bar_health_fill, the pair GameUi drives. The bare wrapper root exists to keep
// that naming; collapsing it renames the track.
component ui_meter {
  prop w: 100%;
  prop c: #ffffff;
  prop h: 11;
  panel box {
    panel track { width: 100%; height: $h; overflow: hidden;
      background: #0a0a0acc; border-color: #000000aa; border-width: 1;
      panel fill { width: $w; height: 100%; background: $c; }
      // marks the bar's maximum, not the fill's edge
      panel { position: absolute; right: 0; top: 0; width: 1; height: 100%; background: #ffffff26; }
    }
  }
}

component ui_hint {
  prop k: "E";
  prop a: "ACTION";
  panel { layout: row; align: center; gap: 12;
    panel cap { width: 26; height: 26; layout: column; justify: center; align: center;
      border-color: #ffffff2e; border-width: 1;
      text t { font-size: 11; color: #ffffff; text: $k; } }
    text a { font-size: 11; color: #5e5e5e; text: $a; letter-spacing: 3; text-transform: uppercase; } }
}

// The front-end's three repeated objects. Each is empty at rest: ApplyMainMenu
// fills every field and hides the rows it has no data for, so an instance costs
// nothing until the engine has something to put in it.

// One savegame on the rail under the tile grid: the launch tile at quarter
// scale and deliberately the same object, down to the 2px top rule for focus.
// `art` carries the screenshot the save file itself holds.
component ui_save_card {
  panel box { width: 260; height: 150; position: relative; overflow: hidden;
    cursor: pointer; border-color: #ffffff1c; border-width: 1; background: #06070a;
    :hover { border-color: #ffffff5e; }
    image art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0.72; }
    panel { position: absolute; left: 0; right: 0; bottom: 0; height: 105;
      background: #00000000; background-end: #000000f2; gradient-angle: 180; }
    panel top { position: absolute; left: 0; right: 0; top: 0; height: 2; background: #ffffff; }
    text when { position: absolute; right: 12; top: 11; font-size: 9; letter-spacing: 2;
      text-transform: uppercase; color: #ffffff8c; text: ""; }
    panel { position: absolute; left: 13; right: 13; bottom: 12; layout: column;
      text no { font-size: 9; letter-spacing: 3; text-transform: uppercase;
        color: #ffffff8c; text: ""; }
      text loc { font-size: 13; letter-spacing: 2; text-transform: uppercase;
        color: #ffffffcc; margin: 6 0 0 0; text: ""; }
      text meta { font-size: 10; letter-spacing: 1; color: #ffffff7a;
        margin: 5 0 0 0; text: ""; } }
  }
}

// A row of the Load list. The pip is the state at a glance (filled = resumes
// as it is, hairline = wants attention), and the verdict is a word at the right
// rather than a colour, per the control rules.
component ui_save_row {
  panel row { layout: row; align: center; height: 42; width: 100%; position: relative;
    cursor: pointer;
    panel { position: absolute; left: 0; right: 0; bottom: 0; height: 1; background: #ffffff0d; }
    panel { width: 26;
      panel pip { width: 5; height: 5; background: #ffffff; } }
    text no { width: 64; font-size: 12; letter-spacing: 1; color: #5e5e5e; text: ""; }
    text name { width: 210; font-size: 13; letter-spacing: 1; color: #ffffffd6; text: ""; }
    text lvl { width: 64; font-size: 12; letter-spacing: 1; color: #5e5e5e; text: ""; }
    text loc { flex-grow: 1; font-size: 13; letter-spacing: 1; color: #9a9a9a; text: ""; }
    text play { width: 96; font-size: 11; letter-spacing: 1; color: #5e5e5e; text: ""; }
    text when { width: 132; font-size: 11; letter-spacing: 1; color: #5e5e5e; text: ""; }
    panel { width: 210; layout: row; justify: end;
      text state { font-size: 9; letter-spacing: 3; text-transform: uppercase;
        color: #5e5e5e; text: ""; } }
  }
}

// A row of the Join list. A friend's coop session and a 128-slot server are the
// same row with a different gametype, which is the whole argument for one list.
component ui_server_row {
  panel row { layout: row; align: center; height: 42; width: 100%; position: relative;
    cursor: pointer;
    panel { position: absolute; left: 0; right: 0; bottom: 0; height: 1; background: #ffffff0d; }
    panel { width: 26;
      panel pip { width: 5; height: 5; background: #ffffff; } }
    text name { flex-grow: 1; font-size: 13; letter-spacing: 1; color: #ffffffd6; text: ""; }
    text world { width: 126; font-size: 12; letter-spacing: 1; color: #5e5e5e; text: ""; }
    text kind { width: 196; font-size: 12; letter-spacing: 1; color: #5e5e5e; text: ""; }
    text slots { width: 96; font-size: 11; letter-spacing: 1; color: #5e5e5e; text: ""; }
    text ping { width: 82; font-size: 11; letter-spacing: 1; color: #5e5e5e; text: ""; }
    panel { width: 196; layout: row; justify: end;
      text state { font-size: 9; letter-spacing: 3; text-transform: uppercase;
        color: #5e5e5e; text: ""; } }
  }
}

