// Vitals, top-left. The engine drives each fill's width every frame.
//
// All three fills are white; they are told apart by bar length and stack order
// (health 420, stamina 360, magicka 320). Hue is reserved for the domain accent.

  panel vitals {
    position: absolute; left: 52; top: 48; layout: column; gap: 7;
    ui_meter bar_health  { width: 420; w: 100%; }
    ui_meter bar_magicka { width: 320; w: 100%; }
    ui_meter bar_stamina { width: 360; w: 100%; }
  }
