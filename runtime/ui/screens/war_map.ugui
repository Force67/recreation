// The Civil War campaign board. war_hold0..8 (kWarHoldRows) is a fixed pool
// filled in GameUi::Build and coloured by side: white Imperial, signal-red
// Stormcloak, grey contested.

  panel war_map_box {
    position: absolute; left: 0; top: 0; width: 100vw; height: 100vh;
    background: #000000e0; backdrop-blur: 26;
    panel war_map_card { position: absolute; left: 130; right: 130; top: 76; bottom: 0;
      layout: column;
      panel { layout: row; align: end; justify: space-between; width: 100%;
        text war_map_head { class: t_mast; text: "War for Skyrim"; }
        text war_map_hint { class: t_micro2; text: "M to close"; }
      }
      panel { width: 100%; height: 1; margin: 26 0 0 0;
        background: #ffffff66; background-end: #ffffff00; gradient-angle: 90; }

      panel { flex-grow: 1; layout: row; align: stretch; width: 100%; padding: 44 0 0 0;
        panel { width: 560; layout: column;
          text war_map_sub { class: t_micro; text: ""; margin: 0 0 18 0; }
          text war_hold0 { class: t_body; text: ""; font-size: 16; margin: 0 0 10 0; }
          text war_hold1 { class: t_body; text: ""; font-size: 16; margin: 0 0 10 0; }
          text war_hold2 { class: t_body; text: ""; font-size: 16; margin: 0 0 10 0; }
          text war_hold3 { class: t_body; text: ""; font-size: 16; margin: 0 0 10 0; }
          text war_hold4 { class: t_body; text: ""; font-size: 16; margin: 0 0 10 0; }
          text war_hold5 { class: t_body; text: ""; font-size: 16; margin: 0 0 10 0; }
          text war_hold6 { class: t_body; text: ""; font-size: 16; margin: 0 0 10 0; }
          text war_hold7 { class: t_body; text: ""; font-size: 16; margin: 0 0 10 0; }
          text war_hold8 { class: t_body; text: ""; font-size: 16; margin: 0 0 10 0; }
        }
        panel { width: 1; background: #ffffff1c; }
        panel { flex-grow: 1; layout: column; padding: 0 0 0 56;
          text { class: t_micro; text: "Imperial control"; margin: 0 0 18 0; }
          ui_meter war_bar { width: 100%; max-width: 560; w: 1%; h: 14; }
          text war_map_progress { class: t_body; text: ""; margin: 18 0 0 0; }
          panel war_map_rule { class: rule_dim; width: 100%; max-width: 560; margin: 26 0 0 0; }
        }
      }
      panel { height: 96; layout: row; align: center; gap: 44; width: 100%;
        panel { position: absolute; left: 0; right: 0; top: 0; height: 1; background: #ffffff1c; }
        ui_hint { k: "M"; a: "Close"; }
      }
    }
  }
