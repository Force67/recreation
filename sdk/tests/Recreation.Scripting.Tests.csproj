<Project Sdk="Microsoft.NET.Sdk">

  <!-- A dependency-free test runner for the managed scripting layer. A plain
       console app (no xunit, so it restores and runs offline) that exercises the
       pure-managed framework: the event bus, behaviour lifecycle, mod discovery
       and the value/marshalling types. Run with `dotnet run`; it exits with the
       failure count. The native-boundary code (Native, the bridge) is covered
       end to end by the pexrun hosttest instead. -->
  <!-- The fixtures/ subtree has projects of its own; their sources (and their
       generated obj sources) must not leak into this project's default globs. -->
  <ItemGroup>
    <Compile Remove="fixtures/**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <AssemblyName>Recreation.Scripting.Tests</AssemblyName>
    <RootNamespace>Recreation.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The SDK plus the default gamemodes, which now build as their own assemblies.
       The tests cover the per-game rulesets, so reference each game project (they
       are copied next to the test runner and resolve the shared SDK once). -->
  <ItemGroup>
    <ProjectReference Include="..\Recreation.Scripting.csproj" />
    <ProjectReference Include="..\default_gamemodes\Skyrim\Recreation.Skyrim.csproj" />
    <ProjectReference Include="..\default_gamemodes\Fallout\Recreation.Fallout.csproj" />
    <ProjectReference Include="..\default_gamemodes\Starfield\Recreation.Starfield.csproj" />
    <ProjectReference Include="..\default_gamemodes\SkyrimCartRacing\Recreation.SkyrimCartRacing.csproj" />
    <ProjectReference Include="..\default_gamemodes\TourDeRecreation\Recreation.TourDeRecreation.csproj" />
  </ItemGroup>

  <!-- The streamed-script fixtures build alongside the tests but stay out of
       the test output directory (Private=false): the streamed-loader tests
       reach them in their own bin dirs, and the directory-loading tests must
       not pick them up. -->
  <ItemGroup>
    <ProjectReference Include="fixtures\StreamedDepLib\StreamedDepLib.csproj" Private="false" />
    <ProjectReference Include="fixtures\StreamedUsesDep\StreamedUsesDep.csproj" Private="false" />
  </ItemGroup>

</Project>
